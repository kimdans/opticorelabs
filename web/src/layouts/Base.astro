---
import '../styles/global.css';
import { company, nav } from '../data/site';

interface Props { title?: string; description?: string; }
const { title, description = company.summary } = Astro.props;
const fullTitle = title ? `${title} · 오티코어` : `오티코어 OptiCore · ${company.tagline}`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const org = {
  '@context': 'https://schema.org', '@type': 'Organization',
  name: company.nameKo, alternateName: company.nameEn, url: Astro.site?.href, description: company.summary,
  knowsAbout: ['시스템 통합', 'ERP 구축', 'AI 전환', 'SaaS'],
};
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable summary">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta name="theme-color" content="#0B0C0E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=IBM+Plex+Sans+KR:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap">
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
</head>
<body>
  <a class="skip" href="#main">본문으로 건너뛰기</a>
  <header class="hud gut">
    <div class="inner bar">
      <a class="logo" href="/" aria-label="오티코어 홈">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="3"/><rect x="8.5" y="8.5" width="7" height="7" rx="1.2" fill="var(--core)"/></svg>
        opticore
      </a>
      <nav aria-label="주요 메뉴" class="links">
        {nav.map(n => <a href={n.href} aria-current={path.startsWith(n.match ?? n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <div class="right">
        <slot name="hud" />
        <a class="btn small" href="/diagnose">진단 시작</a>
        <details class="menu">
          <summary aria-label="메뉴 열기"><span></span><span></span></summary>
          <nav aria-label="모바일 메뉴">
            {nav.map(n => <a href={n.href}>{n.label}</a>)}
            <a href="/diagnose">진단 시작</a>
          </nav>
        </details>
      </div>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="gut">
    <div class="inner foot">
      <div>
        <p class="name">{company.nameKo} · {company.nameEn}</p>
        <p>사업자등록번호 {company.bizNo} · {company.address}{company.placeholder && ' (예시)'}</p>
        <p>{company.email}{company.placeholder && ' (예시)'}</p>
      </div>
      <div class="flinks">
        <a href="/method">일하는 순서</a><a href="/principles">원칙</a><a href="/company">회사</a><a href="/llms.txt">llms.txt</a>
      </div>
    </div>
  </footer>
</body>
</html>

<style>
  .hud { position: fixed; top: 0; left: 0; right: 0; z-index: 40; padding-top: env(safe-area-inset-top, 0px); background: color-mix(in srgb, var(--body) 72%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-block: 12px; }
  .logo { display: flex; align-items: center; gap: 10px; font-family: var(--f-display); font-weight: 600; font-size: 19px; letter-spacing: -.02em; text-decoration: none; }
  .logo svg { width: 24px; height: 24px; }
  .links { display: flex; gap: 26px; font-size: 14px; }
  .links a { color: var(--ink-2); text-decoration: none; }
  .links a:hover, .links a[aria-current] { color: var(--ink); }
  .right { display: flex; align-items: center; gap: 16px; }
  .btn.small { padding: 8px 14px; font-size: 14px; }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; cursor: pointer; width: 36px; height: 36px; display: grid; place-content: center; gap: 5px; border-radius: 8px; box-shadow: inset 0 0 0 1px var(--edge); }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary span { display: block; width: 16px; height: 1.5px; background: var(--ink); transition: transform .2s; }
  .menu[open] summary span:first-child { transform: translateY(3.25px) rotate(45deg); }
  .menu[open] summary span:last-child { transform: translateY(-3.25px) rotate(-45deg); }
  .menu nav { position: absolute; right: 0; top: 46px; min-width: 200px; display: grid; background: var(--body-2); border: 1px solid var(--edge); border-radius: 12px; padding: 8px; }
  .menu nav a { padding: 10px 12px; text-decoration: none; border-radius: 6px; }
  .menu nav a:hover { background: var(--blade-b); }
  @media (max-width: 820px) { .links { display: none; } .menu { display: block; } }
  @media (max-width: 420px) { .right :global(.hud-exif) { display: none; } }
  footer { border-top: 1px solid var(--line); }
  .foot { padding-block: 40px; display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; font-size: 13px; color: var(--ink-2); }
  .foot .name { color: var(--ink); font-weight: 500; }
  .flinks { display: flex; gap: 18px; flex-wrap: wrap; }
  .flinks a { text-decoration: none; }
  .flinks a:hover { color: var(--ink); }
</style>

<script>
  import { initMotion } from '../scripts/motion';
  initMotion();
</script>
