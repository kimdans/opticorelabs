---
import { url } from '../lib/paths';
import '../styles/global.css';
import { company, nav } from '../data/site';
import { business, ftcBizInfoUrl } from '../data/business';

interface Props { title: string; description: string; noindex?: boolean; canonical?: boolean; }
// 모든 페이지는 고유한 title과 description을 넘긴다 (광고 랜딩 심사 기준).
const { title, description, noindex = false, canonical: withCanonical = true } = Astro.props;
const fullTitle = title === company.nameKo ? `${company.nameKo} · ${company.tagline}` : `${title} · 옵티코어`;
const path = Astro.url.pathname;
const canonical = new URL(path.replace(/index(\.html)?$/, '').replace(/\.html$/, ''), Astro.site).href;
const org = {
  '@context': 'https://schema.org', '@type': 'Organization',
  name: business.name, alternateName: company.nameEn, url: new URL(url('/'), Astro.site).href,
  description: company.summary, email: business.email,
};
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  {withCanonical && <link rel="canonical" href={canonical}>}
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml">
  <link rel="alternate" type="text/plain" href={url('/llms.txt')} title="LLM-readable summary">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={business.name}>
  <meta property="og:locale" content="ko_KR">
  {withCanonical && <meta property="og:url" content={canonical}>}
  <meta name="theme-color" content="#EDF0EF">
  <link rel="stylesheet" href={url('/fonts/pretendard/pretendard.css')}>
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
</head>
<body>
  <a class="skip" href="#main">본문으로 건너뛰기</a>
  <header class="hud gut" data-hud>
    <div class="inner bar">
      <a class="logo" href={url('/')} aria-label="옵티코어 홈">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="3.2"/><rect x="8.4" y="8.4" width="7.2" height="7.2" rx="1.4" fill="var(--core)"/></svg>
        opticore
      </a>
      <nav aria-label="주요 메뉴" class="links">
        {nav.map(n => <a href={url(n.href)} aria-current={n.match && path.startsWith(url(n.match)) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <div class="right">
        <a class="btn small" href={`mailto:${business.email}`}>이메일 문의</a>
        <details class="menu">
          <summary aria-label="메뉴 열기"><span></span><span></span></summary>
          <nav aria-label="모바일 메뉴">
            {nav.map(n => <a href={url(n.href)}>{n.label}</a>)}
          </nav>
        </details>
      </div>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="gut">
    <div class="inner foot">
      <div class="who">
        <a class="logo" href={url('/')} aria-label="옵티코어 홈">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="3.2"/><rect x="8.4" y="8.4" width="7.2" height="7.2" rx="1.4" fill="var(--core)"/></svg>
          opticore
        </a>
        <p class="tag">{company.short}</p>
      </div>
      <nav class="fcol" aria-label="안내">
        <p>안내</p>
        <a href={url('/#fields')}>분야</a><a href={url('/#how')}>이용 방법</a><a href={url('/partners')}>제휴 안내</a>
      </nav>
      <nav class="fcol" aria-label="회사">
        <p>회사</p>
        <a href={url('/company')}>회사 정보</a><a href={url('/privacy')}>개인정보 처리방침</a><a href={`mailto:${business.email}`}>이메일 문의</a>
      </nav>
    </div>
    <div class="inner legal" data-business-info>
      <dl class="biz">
        <div><dt>상호</dt><dd>{business.name}</dd></div>
        <div><dt>대표</dt><dd>{business.ceo}</dd></div>
        <div><dt>사업자등록번호</dt><dd>{business.bizNo} <a href={ftcBizInfoUrl} target="_blank" rel="noopener">사업자정보 확인</a></dd></div>
        <div><dt>통신판매업 신고번호</dt><dd>{business.mailOrderNo}</dd></div>
        <div><dt>소재지</dt><dd>{business.address}</dd></div>
        <div><dt>이메일</dt><dd><a href={`mailto:${business.email}`}>{business.email}</a></dd></div>
      </dl>
      <p class="copy"><a href={url('/privacy')}><strong>개인정보 처리방침</strong></a><span>© {year} {business.name}. All rights reserved.</span></p>
    </div>
  </footer>
</body>
</html>

<style>
  .hud { position: fixed; top: 0; left: 0; right: 0; z-index: 40; padding-top: env(safe-area-inset-top, 0px); background: color-mix(in srgb, var(--body) 86%, transparent); backdrop-filter: saturate(1.6) blur(14px); -webkit-backdrop-filter: saturate(1.6) blur(14px); border-bottom: 1px solid transparent; transition: border-color .3s; }
  .hud.scrolled { border-bottom-color: var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 68px; }
  .logo { display: inline-flex; align-items: center; gap: 9px; font-weight: 700; font-size: 20px; letter-spacing: -.04em; text-decoration: none; color: var(--ink); }
  .logo svg { width: 24px; height: 24px; }
  .links { display: flex; gap: 4px; font-size: 15px; font-weight: 500; }
  .links a { color: var(--ink-2); text-decoration: none; padding: 8px 14px; border-radius: 999px; transition: color .2s, background .2s; }
  .links a:hover { color: var(--ink); background: var(--surface); }
  .links a[aria-current] { color: var(--ink); }
  .right { display: flex; align-items: center; gap: 10px; }
  .btn.small { min-height: 44px; padding: 0 18px; font-size: 15px; white-space: nowrap; }
  @media (max-width: 380px) { .btn.small { padding: 0 14px; font-size: 14px; } }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; cursor: pointer; width: 44px; height: 44px; display: grid; place-content: center; gap: 6px; border-radius: 50%; background: var(--surface); }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary span { display: block; width: 16px; height: 1.5px; background: var(--ink); transition: transform .25s var(--ease); }
  .menu[open] summary span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .menu[open] summary span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
  /* 모바일 메뉴: 헤더 아래 화면 폭 전체를 덮는 패널 */
  .menu nav { position: fixed; left: 0; right: 0; top: calc(env(safe-area-inset-top, 0px) + 68px); display: grid; background: var(--body); border-bottom: 1px solid var(--line); padding: 8px max(20px, env(safe-area-inset-right, 0px)) 20px max(20px, env(safe-area-inset-left, 0px)); box-shadow: 0 24px 40px -24px rgba(12, 16, 22, .18); }
  .menu nav a { padding: 16px 0; font-size: 20px; font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--line); }
  .menu nav a:last-child { border-bottom: 0; }
  @media (max-width: 820px) { .links { display: none; } .menu { display: block; } .bar { height: 60px; } .menu nav { top: calc(env(safe-area-inset-top, 0px) + 60px); } }

  footer { background: var(--body-2); padding-block: 72px 40px; }
  .foot { display: grid; grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr)); gap: 40px 32px; }
  @media (max-width: 820px) { .foot { grid-template-columns: repeat(2, minmax(0, 1fr)); } .who { grid-column: 1 / -1; } }
  .who { display: grid; gap: 12px; align-content: start; justify-items: start; }
  .tag { color: var(--ink-2); font-size: 15px; }
  .fcol { display: grid; gap: 4px; align-content: start; justify-items: start; font-size: 15px; }
  .fcol p { font-weight: 600; margin-bottom: 8px; }
  .fcol a { color: var(--ink-2); text-decoration: none; padding-block: 6px; }
  .fcol a:hover { color: var(--ink); }
  .legal { margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--edge); display: grid; gap: 12px; font-size: 13px; color: var(--ink-2); }
  .biz { display: flex; flex-wrap: wrap; gap: 4px 18px; margin: 0; }
  .biz div { display: flex; gap: 6px; min-width: 0; }
  .biz dt { color: var(--ink-3); flex: none; }
  .biz dd { margin: 0; min-width: 0; }
  .legal a { color: var(--ink); }
  .copy { color: var(--ink-3); display: flex; flex-wrap: wrap; gap: 4px 16px; }
</style>

<script>
  import { initReveal } from '../scripts/reveal';
  initReveal();
  // 스크롤하면 헤더 아래에 선이 생긴다
  const hud = document.querySelector('[data-hud]');
  const onScroll = () => hud?.classList.toggle('scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true }); onScroll();
</script>
