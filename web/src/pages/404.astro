---
import { url } from '../lib/paths';
import Base from '../layouts/Base.astro';
---
<Base title="페이지를 찾을 수 없음" description="요청하신 주소의 페이지를 찾을 수 없습니다. 옵티코어 홈이나 제휴 서비스 안내 목록에서 원하시는 안내를 찾아보세요." noindex canonical={false}>
  <section class="page-hero gut" style="min-height:70svh">
    <div class="inner">
      <p class="eyebrow">404</p>
      <h1 class="page-title">찾으시는 페이지가 없습니다.</h1>
      <p class="lede">주소가 바뀌었거나 더 이상 운영하지 않는 안내 페이지일 수 있습니다. 홈이나 제휴 안내 목록에서 원하시는 서비스를 찾아보세요.</p>
      <p style="margin-top:28px;display:flex;gap:10px;flex-wrap:wrap"><a class="btn" href={url('/')}>홈으로</a><a class="btn ghost" href={url('/partners')}>제휴 안내 보기</a></p>
    </div>
  </section>
</Base>
