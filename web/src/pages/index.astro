---
import { url } from '../lib/paths';
import Base from '../layouts/Base.astro';
import PartnerList from '../components/PartnerList.astro';
import { company, fields, steps, principles } from '../data/site';
---
<Base title={company.nameKo} description="이사·정리·청소, 학습, 렌탈처럼 일상에 필요한 서비스를 비교하고 제휴 업체에 직접 상담을 신청하실 수 있도록 안내하는 마케팅 회사, 주식회사 옵티코어입니다. 옵티코어는 상담 비용을 받지 않습니다.">
  <section class="hero gut">
    <div class="inner hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">생활 · 교육 · 렌탈 서비스 안내</p>
        <h1 class="hero-title">일상에 필요한 서비스,<br>비교해 보고 업체에 직접 신청하세요.</h1>
        <p class="lede">{company.summary}</p>
        <p class="cta"><a class="btn core" href={url('/partners')}>제휴 안내 보기</a><a class="btn ghost" href="#how">이용 방법</a></p>
      </div>
      <aside class="hero-card" aria-label="옵티코어가 하는 일과 하지 않는 일">
        <p class="card-h">옵티코어가 하는 일</p>
        <ul>
          <li>분야별 서비스 내용과 확인할 점을 정리해 안내합니다</li>
          <li>서비스를 제공하는 제휴 업체를 안내 페이지마다 밝힙니다</li>
          <li>상담을 신청하실 수 있는 업체 페이지로 이어 드립니다</li>
        </ul>
        <p class="card-h no">하지 않는 일</p>
        <ul class="no">
          <li>상담 비용을 받지 않습니다</li>
          <li>이름·연락처 같은 개인정보를 받지 않습니다</li>
          <li>서비스를 직접 제공하거나 계약하지 않습니다</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section tint gut" id="fields" aria-labelledby="fields-h">
    <div class="inner">
      <div class="sec-head">
        <p class="eyebrow">분야</p>
        <h2 id="fields-h">옵티코어가 안내하려는 세 가지 분야</h2>
        <p>집안일부터 아이의 공부, 매달 쓰는 생활용품까지. 직접 알아보기 번거로운 서비스를 분야별로 정리하는 것을 목표로 합니다.</p>
      </div>
      <ul class="fields" role="list" data-reveal="children">
        {fields.map(f => (
          <li class="field">
            <h3>{f.name}</h3>
            <p class="chips">{f.items.map(i => <span class="chip">{i}</span>)}</p>
            <p class="body">{f.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section gut" id="how" aria-labelledby="how-h">
    <div class="inner">
      <div class="sec-head">
        <p class="eyebrow">이용 방법</p>
        <h2 id="how-h">비교하고, 확인하고, 업체에 직접 신청하세요</h2>
        <p>옵티코어는 안내까지만 합니다. 상담과 서비스는 각 제휴 업체가 직접 진행합니다.</p>
      </div>
      <ol class="steps" data-reveal="children">
        {steps.map((s, i) => (
          <li><span class="num" aria-hidden="true">{i + 1}</span><h3>{s.title}</h3><p>{s.body}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section tint gut" id="principles" aria-labelledby="pr-h">
    <div class="inner">
      <div class="sec-head">
        <p class="eyebrow">운영 원칙</p>
        <h2 id="pr-h">안내하는 회사로서 지키는 것</h2>
      </div>
      <ul class="prs" role="list" data-reveal="children">
        {principles.map(p => <li><h3>{p.title}</h3><p>{p.body}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section gut" id="partners" aria-labelledby="pt-h">
    <div class="inner">
      <div class="sec-head">
        <p class="eyebrow">제휴 안내</p>
        <h2 id="pt-h">제휴 서비스 안내 페이지</h2>
        <p>서비스마다 어떤 분께 맞는지, 진행 방식, 신청 전 확인할 점, 자주 묻는 질문을 한 페이지에 정리합니다.</p>
      </div>
      <PartnerList />
      <p class="more"><a class="btn ghost" href={url('/partners')}>제휴 안내 전체 보기</a></p>
    </div>
  </section>

  <section class="section tint gut" id="contact" aria-labelledby="ct-h">
    <div class="inner contact">
      <div class="sec-head">
        <p class="eyebrow">문의</p>
        <h2 id="ct-h">궁금한 점은 이메일로 보내 주세요</h2>
        <p>안내 내용에 대한 문의, 제휴 문의 모두 이메일로 받습니다. 서비스 이용·계약에 관한 문의는 해당 서비스를 제공하는 업체에 해 주세요.</p>
      </div>
      <p><a class="btn" href={`mailto:${company.email}`}>{company.email}</a></p>
      <div class="about" data-company-about>
        <p><strong>{company.nameKo}</strong> · {company.short}</p>
        <p data-business-line>{company.businessLine}</p>
        <p><a href={url('/company')}>회사 정보 보기</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: 148px 104px; }
  @media (max-width: 760px) { .hero { padding-block: 108px 72px; } }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  @media (max-width: 960px) { .hero-grid { grid-template-columns: minmax(0, 1fr); } }
  .hero-copy { display: grid; gap: 20px; }
  .hero-title { font-size: clamp(32px, 5vw, 62px); font-weight: 700; letter-spacing: -.04em; }
  @media (max-width: 560px) { .hero-title br { display: none; } }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px; }
  .hero-card { background: var(--surface); border-radius: 24px; padding: 32px; display: grid; gap: 12px; }
  .card-h { font-weight: 700; display: flex; align-items: center; gap: 10px; }
  .card-h::before { content: ""; width: 9px; height: 9px; border-radius: 2.5px; background: var(--core); }
  .card-h.no { margin-top: 12px; }
  .card-h.no::before { background: transparent; box-shadow: inset 0 0 0 1.5px var(--ink-3); }
  .hero-card ul { margin: 0; padding-left: 19px; display: grid; gap: 6px; color: var(--ink-2); font-size: 15px; }

  .fields { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 900px) { .fields { grid-template-columns: minmax(0, 1fr); } }
  .field { background: var(--surface); border-radius: 20px; padding: 32px; display: grid; gap: 14px; align-content: start; }
  .field h3 { font-size: 26px; }
  .field .chip { background: var(--body-2); }
  .field .body { color: var(--ink-2); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; counter-reset: s; }
  @media (max-width: 900px) { .steps { grid-template-columns: minmax(0, 1fr); gap: 24px; } }
  .steps li { display: grid; gap: 10px; align-content: start; border-top: 1.5px solid var(--ink); padding-top: 20px; }
  .num { width: 32px; height: 32px; border-radius: 9px; background: var(--core); color: var(--on-core); display: grid; place-content: center; font-weight: 700; }
  .steps h3 { font-size: 21px; }
  .steps p { color: var(--ink-2); }

  .prs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 760px) { .prs { grid-template-columns: minmax(0, 1fr); } }
  .prs li { background: var(--surface); border-radius: 20px; padding: 28px; display: grid; gap: 8px; }
  .prs h3 { font-size: 20px; }
  .prs p { color: var(--ink-2); }

  .more { margin-top: 28px; }
  .contact .btn { max-width: 100%; overflow-wrap: anywhere; }
  .about { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--line); display: grid; gap: 6px; font-size: 15px; color: var(--ink-2); max-width: 52em; }
  .about strong { color: var(--ink); }
</style>
