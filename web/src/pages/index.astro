---
import { url } from '../lib/paths';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Compare from '../components/Compare.astro';
import ServiceTabs from '../components/ServiceTabs.astro';
import FitMatrix from '../components/FitMatrix.astro';
import Timeline from '../components/Timeline.astro';
import Promises from '../components/Promises.astro';
import BrandFilm from '../components/BrandFilm.astro';
import Diagnose from '../components/Diagnose.astro';
import { company } from '../data/site';
// 홈의 이야기 순서 (AX 전문 구축팀):
// 에이전트가 일하는 장면 → 찾아오는 분들의 고민 → AI보다 먼저 할 일(업무를 선명하게) → 상황별 서비스 → 우리 방식(점수·승인·측정) → 일정 → 약속 → 필름 → 진단
const worries = [
  { who: '대표', say: 'AI를 도입하라는 말은 많은데, 우리 회사는 어디서부터 해야 할지 모르겠습니다.' },
  { who: '운영 총괄', say: '직원들은 챗봇을 쓰는데 회사 업무는 그대로입니다. 엑셀과 메신저가 줄지 않아요.' },
  { who: '실무 팀장', say: 'AI가 틀린 내용을 거래처에 보내면 누가 책임지나요? 그게 걱정돼서 못 맡깁니다.' },
];
const ways = [
  { t: '점수로 고릅니다', b: '업무마다 빈도와 효과를 1~10으로 매기고 곱합니다. 점수가 높은 일부터 맡기고, 낮은 일은 기록만 해 둡니다.' },
  { t: '사람이 승인합니다', b: '거래처에 나가는 문서, 돈이 움직이는 일에는 항상 담당자 승인 단계를 둡니다. 누가 언제 승인했는지 남습니다.' },
  { t: '효과를 숫자로 잽니다', b: '시범 에이전트를 먼저 돌려 걸리는 시간과 오류를 재고, 그 결과를 보고 넓힐지 정합니다.' },
];
---
<Base>
  <Hero />

  <section class="section gut" id="worries" aria-labelledby="worries-title">
    <div class="inner">
      <div class="sec-head" data-reveal>
        <p class="eyebrow">찾아오시는 분들</p>
        <h2 id="worries-title">직원 30~200명 회사에서 이런 고민을 하고 계신다면</h2>
      </div>
      <ul class="worries" data-reveal="children">
        {worries.map(w => <li><p class="say">{w.say}</p><p class="who">{w.who}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section gut tint" id="clear" aria-labelledby="clear-title">
    <div class="inner">
      <div class="sec-head" data-reveal>
        <p class="eyebrow">AI보다 먼저 할 일</p>
        <h2 id="clear-title">AI는 흐릿한 업무를 대신해 주지 못합니다</h2>
        <p>데이터가 엑셀과 단체방에 흩어져 있으면 에이전트가 볼 수 있는 것이 없습니다. 그래서 업무를 한 화면으로 정리하는 일부터 합니다.</p>
      </div>
      <ul class="pairs" data-reveal="children" aria-label="정리 전과 후">
        <li><s>견적서_최종_진짜최종.xlsx</s><b>견적·수주</b></li>
        <li><s>단체방으로 받는 결재</s><b>전자결재</b></li>
        <li><s>김대리만 아는 재고</s><b>실시간 재고</b></li>
        <li><s>월말 마감 4일</s><b>마감 자동화</b></li>
      </ul>
      <div data-reveal><Compare /></div>
    </div>
  </section>

  <section class="section gut" id="services" aria-labelledby="services-title">
    <div class="inner">
      <div class="sec-head" data-reveal>
        <p class="eyebrow">서비스</p>
        <h2 id="services-title">지금 상황에서 시작합니다</h2>
        <p>AI 전환이 중심이고, ERP·시스템 통합·구독형 모듈은 AI가 일할 바탕을 만드는 일입니다. 두 가지 이상이 필요해도 계약 창구와 책임자는 한 명입니다.</p>
      </div>
      <div data-reveal><ServiceTabs /></div>
    </div>
  </section>

  <section class="section gut tint" id="way" aria-labelledby="way-title">
    <div class="inner">
      <div class="sec-head" data-reveal>
        <p class="eyebrow">옵티코어 방식</p>
        <h2 id="way-title">어떤 업무부터 AI에 맡길지, 감이 아니라 점수로 정합니다</h2>
      </div>
      <div data-reveal><FitMatrix /></div>
      <ul class="ways" data-reveal="children">
        {ways.map(w => <li><h3>{w.t}</h3><p>{w.b}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section gut" id="method" aria-labelledby="method-title">
    <div class="inner">
      <div class="sec-head" data-reveal>
        <p class="eyebrow">진행 방식</p>
        <h2 id="method-title">진단부터 운영까지, 단계마다 통과 조건이 있습니다</h2>
        <p>조건을 통과해야 다음 단계로 넘어갑니다. 아래 일정은 직원 30~200명 규모 회사를 기준으로 한 일반적인 기간입니다.</p>
      </div>
      <div data-reveal><Timeline /></div>
      <p class="after-link" data-reveal><a class="btn ghost" href={url('/method')}>단계별 산출물 보기</a></p>
    </div>
  </section>

  <section class="section gut night" id="promises" aria-labelledby="promises-title">
    <div class="inner">
      <div class="sec-head" data-reveal>
        <p class="eyebrow">약속</p>
        <h2 id="promises-title">프로젝트 동안 지키는 세 가지</h2>
      </div>
      <Promises />
    </div>
  </section>

  <section class="section gut" aria-labelledby="film-intro" style="padding-bottom:0">
    <div class="inner">
      <div class="sec-head" data-reveal style="margin-bottom:0">
        <p class="eyebrow">브랜드 필름</p>
        <h2 id="film-intro">흩어진 업무가 하나의 코어로 모이기까지, 15초</h2>
      </div>
    </div>
  </section>
  <BrandFilm bare />

  <section class="section gut tint" id="diagnose-section" aria-labelledby="diag-title">
    <div class="inner">
      <div class="sec-head" data-reveal>
        <p class="eyebrow">진단 · 약 1분</p>
        <h2 id="diag-title">세 가지만 고르면 어디서 시작할지 알려드립니다</h2>
        <p>결과를 보내 주시면 담당자가 같은 내용을 보고 이야기를 시작합니다. 메일({company.email})로 바로 문의하셔도 됩니다.</p>
      </div>
      <Diagnose bare />
    </div>
  </section>
</Base>

<style>
  .after-link { margin-top: 40px; }
  /* 찾아오는 분들의 고민: 후기가 아니라 자주 듣는 질문이다 */
  .worries { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 900px) { .worries { grid-template-columns: 1fr; } }
  .worries li { background: var(--surface); border-radius: 24px; padding: clamp(24px, 2.6vw, 34px); display: grid; gap: 28px; align-content: space-between; }
  .say { font-size: clamp(18px, 1.6vw, 21px); font-weight: 600; line-height: 1.55; letter-spacing: -.02em; }
  .say::before { content: "“"; display: block; font-size: 44px; line-height: .7; color: var(--core); margin-bottom: 10px; font-weight: 700; }
  .who { font-size: 14px; font-weight: 600; color: var(--ink-2); }

  /* 브랜드 문법 "취소선 → 코어 칩": 정리 전 이름에 줄을 긋고, 정리된 기능 이름을 붙인다 */
  .pairs { list-style: none; margin: 0 0 40px; padding: 0; display: flex; flex-wrap: wrap; gap: 12px 28px; }
  .pairs li { display: flex; align-items: center; gap: 10px; font-size: 15px; }
  .pairs s { color: var(--ink-3); text-decoration-thickness: 1.5px; }
  .pairs b { font-weight: 600; background: var(--ink); color: var(--body); padding: 5px 12px; border-radius: 999px; font-size: 14px; }
  .pairs s::after { content: "→"; display: inline-block; margin-left: 10px; text-decoration: none; color: var(--ink-3); }

  .ways { list-style: none; margin: 56px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 48px; }
  @media (max-width: 900px) { .ways { grid-template-columns: 1fr; margin-top: 40px; } }
  .ways li { border-top: 1px solid var(--edge); padding-top: 24px; display: grid; gap: 10px; align-content: start; }
  .ways h3 { font-size: clamp(20px, 1.8vw, 24px); font-weight: 700; }
  .ways p { color: var(--ink-2); font-size: 16px; }

  /* 어두운 띠: 페이지 흐름에 한 번만 쓴다 */
  .night { background: var(--night); color: var(--on-night); --muted: var(--on-night-2); }
  .night :global(.sec-head .eyebrow) { color: var(--on-night); }
  .night :global(.sec-head .eyebrow::before) { background: #8089FF; }
</style>
