---
// 제휴 안내 랜딩 템플릿 (R-005). src/data/partners.ts 의 항목 하나로 페이지 하나를 만든다.
// - 상단 가까이 "서비스 제공: ○○" + 제휴 안내 문구
// - 상담 신청 버튼은 운영사 주소로 같은 탭 이동 (target 없음). 자동 이동·meta refresh 없음
// - 채널 태그: ?ch= 값이 허용 목록에 있을 때만 버튼 주소에 붙인다 (JS 없으면 기본 주소 그대로)
// - 개인정보 입력폼 없음. 문의는 이메일만
import { url } from '../../lib/paths';
import Base from '../../layouts/Base.astro';
import { publishedPartners, type Partner } from '../../data/partners';
import { company } from '../../data/site';
import { applyChannel, CHANNELS } from '../../lib/channel';

// 초안(draft) 항목은 페이지를 아예 만들지 않는다 → dist에 없고 라이브에서 404.
export function getStaticPaths() {
  return publishedPartners().map(p => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Partner };
const param = p.channelParam || 'ch';
const disclosure = `이 페이지는 주식회사 옵티코어가 제휴 업체의 서비스를 안내하는 페이지입니다. 상담 신청과 서비스 제공은 ${p.provider}에서 직접 진행하며, 옵티코어는 신청 정보를 받거나 보관하지 않습니다. 옵티코어는 제휴에 따른 수수료를 받을 수 있습니다.`;
const description = `${p.category} 분야 제휴 서비스 안내: ${p.title}. 어떤 분께 맞는지, 진행 방식, 신청 전 확인할 점과 자주 묻는 질문을 정리했습니다.`;
const channelScript = `(function(){var f=(${applyChannel.toString()});var a=${JSON.stringify(CHANNELS)};document.querySelectorAll('a[data-operator-cta]').forEach(function(el){el.setAttribute('href',f(el.getAttribute('href'),location.search,el.getAttribute('data-channel-param'),a));});})();`;
---
<Base title={p.title} description={description}>
  <section class="page-hero gut">
    <div class="inner">
      <p class="eyebrow"><a href={url('/partners')}>제휴 안내</a> · {p.category}</p>
      <p class="provider" data-provider>서비스 제공: <strong>{p.provider}</strong></p>
      <h1 class="page-title">{p.title}</h1>
      <p class="disclosure" data-disclosure>{disclosure}</p>
      <p class="lede">{p.summary}</p>
      <p class="cta"><a class="btn core" href={p.operatorUrl} data-operator-cta data-channel-param={param} rel="sponsored">{p.provider}에서 상담 신청하기</a><a class="btn ghost" href="#checks">신청 전 확인할 점</a></p>
    </div>
  </section>

  <section class="gut">
    <div class="inner imgs">
      {p.images.map(im => im.src
        ? <img src={im.src} alt={im.alt} loading="lazy">
        : <div class="ph" role="img" aria-label={im.alt}><span>{im.alt}</span></div>)}
    </div>
  </section>

  <section class="section gut">
    <div class="inner cols">
      <div>
        <h2>이런 분께 맞습니다</h2>
        <ul class="list">{p.audience.map(a => <li>{a}</li>)}</ul>
      </div>
      <div>
        <h2>진행 방식</h2>
        <ol class="list num">{p.steps.map(s => <li>{s}</li>)}</ol>
      </div>
    </div>
  </section>

  <section class="section tint gut" id="checks">
    <div class="inner">
      <h2>신청 전에 확인할 점</h2>
      <ul class="checks">{p.checks.map(c => <li>{c}</li>)}</ul>
    </div>
  </section>

  <section class="section gut" id="faq">
    <div class="inner faq">
      <h2>자주 묻는 질문</h2>
      {p.faq.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </section>

  <section class="section tint gut" id="apply">
    <div class="inner end">
      <h2>{p.provider}에 상담 신청하기</h2>
      <p class="disclosure">{disclosure}</p>
      <p class="cta"><a class="btn core" href={p.operatorUrl} data-operator-cta data-channel-param={param} rel="sponsored">{p.provider}에서 상담 신청하기</a></p>
      <p class="small">버튼을 누르면 {p.provider}의 페이지로 이동합니다. 이 안내 페이지에 대한 문의: <a href={`mailto:${company.email}`}>{company.email}</a></p>
    </div>
  </section>

  <script is:inline set:html={channelScript}></script>
</Base>

<style>
  .eyebrow a { color: inherit; }
  .provider { margin-top: 16px; display: inline-block; background: var(--surface); border-radius: 999px; padding: 6px 14px; font-size: 15px; }
  .disclosure { margin-top: 16px; max-width: 46em; font-size: 14px; color: var(--ink-2); background: var(--body-2); border-left: 3px solid var(--ink-3); padding: 12px 16px; border-radius: 0 10px 10px 0; }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 28px; }
  .cta .btn { max-width: 100%; text-align: center; }
  .imgs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 16px; }
  .imgs img { width: 100%; border-radius: 20px; }
  .ph { aspect-ratio: 16 / 10; border-radius: 20px; background: #D4D8D7; display: grid; place-content: center; padding: 24px; text-align: center; color: #4C555B; font-size: 14px; }
  h2 { font-size: clamp(26px, 3vw, 38px); font-weight: 700; margin-bottom: 24px; }
  .cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px; }
  @media (max-width: 860px) { .cols { grid-template-columns: minmax(0, 1fr); } }
  .list { margin: 0; padding-left: 22px; display: grid; gap: 10px; color: var(--ink-2); }
  .checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; max-width: 52em; }
  .checks li { background: var(--surface); border-radius: 14px; padding: 16px 20px 16px 48px; position: relative; }
  .checks li::before { content: ""; position: absolute; left: 20px; top: 24px; width: 10px; height: 10px; border-radius: 2.5px; background: var(--core); }
  .faq { max-width: 52em; }
  .faq details { border-top: 1px solid var(--line); }
  .faq details:last-child { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; padding: 18px 0; font-weight: 600; }
  .faq details p { padding-bottom: 18px; color: var(--ink-2); }
  .end { max-width: 52em; }
  .end h2 { margin-bottom: 0; }
  .small { margin-top: 16px; font-size: 14px; color: var(--ink-2); }
</style>
