---
import Base from '../layouts/Base.astro';
import { company } from '../data/site';
const rows = [
  ['법인명', `${company.nameKo} (${company.nameEn})`],
  ['사업 분야', 'SI, ERP 구축, AX(AI 전환), 구독형 SaaS'],
  ['사업자등록번호', `${company.bizNo}${company.placeholder ? ' (예시)' : ''}`],
  ['주소', `${company.address}${company.placeholder ? ' (예시)' : ''}`],
  ['연락처', company.email],
];
---
<Base title="회사" description="주식회사 오티코어 회사 정보.">
  <section class="page-hero gut">
    <div class="inner">
      <p class="eyebrow">회사</p>
      <h1 class="page-title">렌즈처럼, 흩어진 것을 한 점에 모읍니다.</h1>
      <p class="lede">{company.summary}</p>
    </div>
  </section>
  <section class="gut" style="padding-bottom:112px">
    <div class="inner">
      <dl class="info">{rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      <p class="note">팀 소개와 채용 정보는 준비 중입니다.</p>
    </div>
  </section>
</Base>
<style>
  .info { margin: 0; border-top: 1px solid var(--line); max-width: 52em; }
  .info div { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 16px; padding-block: 16px; border-bottom: 1px solid var(--line); }
  @media (max-width: 560px) { .info div { grid-template-columns: 1fr; gap: 4px; } }
  dt { font: 12px var(--f-mono); color: var(--ink-2); letter-spacing: .06em; padding-top: 3px; }
  dd { margin: 0; }
  .note { margin-top: 24px; color: var(--ink-2); font-size: 14px; }
</style>
