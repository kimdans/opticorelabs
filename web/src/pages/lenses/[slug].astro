---
import { url } from '../../lib/paths';
import Base from '../../layouts/Base.astro';
import { lenses, erpOptions, type Lens } from '../../data/site';

export function getStaticPaths() {
  return lenses.map(l => ({ params: { slug: l.slug }, props: { lens: l } }));
}
const { lens } = Astro.props as { lens: Lens };
const i = lenses.findIndex(l => l.slug === lens.slug);
const nextLens = lenses[(i + 1) % lenses.length];
---
<Base title={lens.name} description={`${lens.name}: ${lens.what}`}>
  <section class="page-hero gut">
    <div class="inner hero">
      <div>
        <p class="eyebrow">서비스 · {i + 1} / {lenses.length}</p>
        <h1 class="page-title"><span class="code">{lens.code}</span>{lens.name}</h1>
        <p class="lede">{lens.what}</p>
        <div class="chips" style="margin-top:20px">{lens.tags.map(t => <span class="chip">{t}</span>)}</div>
      </div>
      <nav class="others" aria-label="다른 서비스">
        {lenses.map(l => <a href={url(`/lenses/${l.slug}`)} aria-current={l.slug === lens.slug ? 'page' : undefined}>{l.code}</a>)}
      </nav>
    </div>
  </section>

  <section class="section gut">
    <div class="inner cols" data-reveal="children">
      <div class="block when"><p class="eyebrow">이럴 때</p><p class="big">{lens.when}</p></div>
      <div class="block"><p class="eyebrow">하는 일</p><ul>{lens.does.map(d => <li>{d}</li>)}</ul></div>
      <div class="block"><p class="eyebrow">받는 결과물</p><ul>{lens.outputs.map(d => <li>{d}</li>)}</ul></div>
    </div>
  </section>

  {lens.slug === 'erp' && (
    <section class="section gut">
      <div class="inner">
        <div class="sec-head"><h2>구축 방식은 비교한 뒤에 고릅니다.</h2><p>정답은 회사마다 다릅니다. FOCUS 단계에서 아래 기준으로 비교안을 드립니다.</p></div>
        <div class="tablewrap">
          <table>
            <thead><tr><th scope="col">방식</th><th scope="col">이럴 때 맞음</th><th scope="col">주의할 점</th></tr></thead>
            <tbody>{erpOptions.map(o => <tr><th scope="row">{o.name}</th><td>{o.fit}</td><td>{o.watch}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <section class="section gut">
    <div class="inner end">
      <a class="btn" href={url('/diagnose')}>우리 회사에 맞는지 진단하기</a>
      <a class="nextlink" href={url(`/lenses/${nextLens.slug}`)}>다음 렌즈 <b>{nextLens.code} · {nextLens.name}</b> →</a>
    </div>
  </section>
</Base>
<style>
  .hero { display: flex; justify-content: space-between; align-items: end; gap: 32px; flex-wrap: wrap; }
  .code { display: block; font-family: var(--f-display); font-weight: 800; font-size: clamp(80px, 14vw, 200px); line-height: .85; letter-spacing: -.05em; color: var(--core); font-variation-settings: "opsz" 96; margin-bottom: 12px; }
  .others { display: flex; gap: 6px; }
  .others a { font: 500 13px var(--f-mono); text-decoration: none; border: 1px solid var(--edge); border-radius: 999px; padding: 6px 12px; color: var(--ink-2); }
  .others a[aria-current] { background: var(--core); color: var(--on-core); border-color: var(--core); }
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr; gap: 28px; } }
  .block { display: grid; gap: 12px; align-content: start; }
  .big { font-size: 22px; font-weight: 500; line-height: 1.45; }
  ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  li { padding-left: 18px; position: relative; }
  li::before { content: ""; position: absolute; left: 0; top: .7em; width: 8px; height: 8px; border: 1.5px solid var(--core); border-radius: 50%; }
  .tablewrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; min-width: 560px; }
  th, td { text-align: left; padding: 14px 16px; border-bottom: 1px solid var(--line); vertical-align: top; }
  thead th { font: 400 12px var(--f-mono); color: var(--ink-2); letter-spacing: .06em; }
  tbody th { font-family: var(--f-display); font-weight: 600; white-space: nowrap; }
  td { color: var(--ink-2); }
  .end { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  .nextlink { text-decoration: none; color: var(--ink-2); }
  .nextlink b { color: var(--ink); }
</style>
