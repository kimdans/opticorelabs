---
import { scenarios } from '../data/agent';
// 첫 화면의 핵심 장면: 업무 에이전트가 요청을 받아 사내 데이터를 확인하고, 초안을 만들고, 사람의 승인을 기다린다.
// 서버는 첫 시나리오의 "승인 대기" 화면을 그려 둔다 (스크립트가 없어도 완성된 화면). 스크립트가 켜지면 처음부터 재생한다.
const first = scenarios[0];
---
<div class="agent" data-agent data-state="awaiting">
  <header class="ahead">
    <p class="who">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="3.2"/><rect x="8.4" y="8.4" width="7.2" height="7.2" rx="1.4" fill="var(--core)"/></svg>
      업무 에이전트<small>예시 시나리오</small>
    </p>
    <div class="tabs" role="tablist" aria-label="예시 업무 고르기">
      {scenarios.map((s, i) => <button type="button" role="tab" id={`agent-tab-${s.id}`} data-scn={s.id} aria-selected={i === 0 ? 'true' : 'false'} aria-controls="agent-panel">{s.tab}</button>)}
    </div>
  </header>

  <div class="abody" id="agent-panel" role="tabpanel" aria-labelledby={`agent-tab-${first.id}`}>
    <section class="trace" aria-label="에이전트가 한 일">
      <p class="ask"><b data-team>{first.team}</b><span data-ask>{first.ask}</span></p>
      <ol class="steps" data-steps>
        {first.steps.map(st => (
          <li class="step" data-st="done"><i class="src">{st.src}</i><span class="t">{st.text}</span><span class="o">{st.out}</span><b class="mark" aria-hidden="true"></b></li>
        ))}
      </ol>
      <p class="status" data-status aria-live="polite">담당자 승인을 기다리는 중</p>
    </section>

    <section class="approve" aria-label="사람이 확인하는 단계">
      <p class="lab"><i></i>사람이 확인하는 단계</p>
      <h3 data-title>{first.draft.title}</h3>
      <p class="meta" data-meta>{first.draft.meta}</p>
      <p class="body" data-body>{first.draft.body}</p>
      <div class="acts">
        <button type="button" class="btn core" data-act="approve">{first.draft.action}</button>
        <button type="button" class="btn ghost" data-act="return">수정 요청</button>
      </div>
      <p class="after ok" data-when="approved">승인했습니다. 누가 언제 승인했는지 기록에 남습니다.</p>
      <p class="after" data-when="returned">수정 요청을 남겼습니다. 에이전트가 고쳐서 다시 올립니다.</p>
    </section>
  </div>

  <footer class="afoot">
    <p data-sum>데이터 확인 3번 · 초안 1건 · 사람 승인 1번</p>
    <button type="button" data-act="replay"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.6-5.9M4 4v4.5h4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>다시 보기</button>
  </footer>
</div>

<style>
  .agent { background: var(--surface); border-radius: clamp(20px, 2.4vw, 32px); box-shadow: 0 1px 0 rgba(18, 21, 25, .04), 0 40px 80px -48px rgba(18, 21, 25, .45); display: grid; overflow: hidden; }
  .ahead, .afoot { display: flex; align-items: center; justify-content: space-between; gap: 12px 20px; flex-wrap: wrap; padding: 16px clamp(18px, 2.4vw, 32px); }
  .ahead { border-bottom: 1px solid var(--line); }
  .who { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 16px; }
  .who svg { width: 22px; height: 22px; }
  .who small { font: 500 12px var(--f-mono); color: var(--ink-3); letter-spacing: .02em; border: 1px solid var(--line); border-radius: 999px; padding: 3px 9px; }
  .tabs { display: flex; gap: 4px; background: var(--body); border-radius: 999px; padding: 4px; }
  .tabs button { all: unset; box-sizing: border-box; cursor: pointer; font-size: 14.5px; font-weight: 600; color: var(--ink-2); padding: 9px 16px; border-radius: 999px; white-space: nowrap; transition: color .2s, background .2s; }
  .tabs button[aria-selected="true"] { background: var(--ink); color: var(--body); }
  .tabs button:focus-visible { outline: 2px solid var(--core); outline-offset: 2px; }

  .abody { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }
  @media (max-width: 860px) { .abody { grid-template-columns: 1fr; } }
  .trace { padding: clamp(20px, 2.6vw, 36px); display: grid; gap: 22px; align-content: start; min-width: 0; }
  .ask { display: grid; gap: 8px; justify-items: start; }
  .ask b { font-size: 13px; font-weight: 600; color: var(--ink-3); }
  .ask span { font-size: clamp(18px, 1.7vw, 22px); font-weight: 600; line-height: 1.5; letter-spacing: -.02em; min-height: 3em; }
  .agent[data-state="typing"] .ask span::after { content: ""; display: inline-block; width: 2px; height: 1.05em; margin-left: 3px; vertical-align: -.16em; background: var(--core); animation: blink .9s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .step { display: grid; grid-template-columns: 50px minmax(0, 1fr) auto 20px; align-items: center; gap: 14px; padding: 13px 12px; margin-inline: -12px; border-radius: 4px; font-size: 16px; transition: opacity .35s; }
  .src { font: 500 12px var(--f-mono); font-style: normal; color: var(--ink-2); border: 1px solid var(--edge); border-radius: 6px; padding: 3px 0; text-align: center; }
  .t { font-weight: 500; }
  .o { font: 500 13.5px var(--f-mono); color: var(--ink-2); white-space: nowrap; transition: opacity .3s; }
  .mark { width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; }
  .step[data-st="done"] .mark { background: var(--ink); }
  .step[data-st="done"] .mark::after { content: ""; width: 8px; height: 4px; border-left: 2px solid var(--surface); border-bottom: 2px solid var(--surface); rotate: -45deg; translate: 0 -1px; }
  .step[data-st="wait"] { opacity: .32; }
  .step[data-st="wait"] .o, .step[data-st="run"] .o { opacity: 0; }
  /* 지금 하는 일에 초점 꺾쇠가 걸린다 */
  .step[data-st="run"] { --fm: var(--core); background-color: var(--core-soft); }
  .step[data-st="run"] .src { color: var(--core); border-color: var(--core); }
  .step[data-st="run"] .mark { border: 2px solid var(--core); border-right-color: transparent; animation: spin .7s linear infinite; }
  @keyframes spin { to { rotate: 360deg; } }
  @media (max-width: 520px) { .step { grid-template-columns: 46px minmax(0, 1fr) 20px; row-gap: 2px; } .o { grid-column: 2; grid-row: 2; white-space: normal; } .mark { grid-row: 1; grid-column: 3; } }
  .status { font: 500 13px var(--f-mono); color: var(--ink-3); display: flex; align-items: center; gap: 8px; }
  .status::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--ink-3); }
  .agent[data-state="working"] .status::before, .agent[data-state="typing"] .status::before { background: var(--core); animation: blink 1s steps(2) infinite; }
  .agent[data-state="awaiting"] .status { color: var(--core); }
  .agent[data-state="awaiting"] .status::before { background: var(--core); }
  .agent[data-state="approved"] .status { color: var(--ok); }
  .agent[data-state="approved"] .status::before { background: var(--ok); }

  /* 사람이 확인하는 단계: 초안이 준비되기 전에는 흐리고, 승인 차례가 되면 초점이 맞는다 */
  .approve { margin: clamp(12px, 1.4vw, 20px); padding: clamp(20px, 2.2vw, 30px); border-radius: clamp(14px, 1.6vw, 22px); background: var(--body); display: grid; gap: 12px; align-content: start; transition: filter .6s, opacity .6s, box-shadow .4s; }
  @media (max-width: 860px) { .approve { margin-top: 0; } }
  .agent[data-state="typing"] .approve, .agent[data-state="working"] .approve { filter: blur(5px); opacity: .5; pointer-events: none; }
  .agent[data-state="awaiting"] .approve { box-shadow: inset 0 0 0 2px var(--core); }
  .lab { font-size: 13px; font-weight: 600; color: var(--ink-2); display: flex; align-items: center; gap: 8px; }
  .lab i { width: 8px; height: 8px; border-radius: 2px; background: var(--core); }
  .approve h3 { font-size: clamp(20px, 1.9vw, 24px); font-weight: 700; }
  .meta { font-size: 14.5px; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .body { font-size: 15px; line-height: 1.65; color: var(--ink); background: var(--surface); border-radius: 12px; padding: 14px 16px; }
  .acts { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .acts .btn { min-height: 48px; padding-inline: 20px; font-size: 15px; }
  .after { font-size: 14.5px; font-weight: 500; color: var(--ink-2); }
  .after.ok { color: var(--ok); }
  [data-when] { display: none; }
  .agent[data-state="approved"] [data-when="approved"], .agent[data-state="returned"] [data-when="returned"] { display: block; }
  .agent[data-state="approved"] .acts, .agent[data-state="returned"] .acts { display: none; }

  .afoot { border-top: 1px solid var(--line); font: 500 13px var(--f-mono); color: var(--ink-2); }
  .afoot button { all: unset; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; font: 600 14px var(--f-body); color: var(--ink); padding: 8px 4px; }
  .afoot button svg { width: 16px; height: 16px; }
  .afoot button:focus-visible { outline: 2px solid var(--core); outline-offset: 2px; border-radius: 6px; }
  .agent:not(.live) .afoot button { display: none; }
</style>

<script>
  import { scenarios, type Scenario } from '../data/agent';

  // 실행 화면의 상태: typing(요청 입력) → working(단계 실행) → awaiting(사람 승인 대기) → approved | returned.
  // 시나리오를 바꾸거나 "다시 보기"를 누르면 어느 상태에서든 typing으로 돌아간다.
  type RunState = 'typing' | 'working' | 'awaiting' | 'approved' | 'returned';
  const STATUS: Record<RunState, string> = {
    typing: '요청을 읽는 중', working: '사내 데이터를 확인하는 중', awaiting: '담당자 승인을 기다리는 중',
    approved: '승인됨 · 승인 기록 저장', returned: '수정 요청 받음 · 초안을 고치는 중',
  };
  const wait = (ms: number) => new Promise(r => setTimeout(r, ms));

  document.querySelectorAll<HTMLElement>('[data-agent]').forEach(root => {
    const q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-scn]'));
    const steps = q('[data-steps]'), status = q('[data-status]'), ask = q('[data-ask]'), panel = q('.abody');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const tpl = steps.firstElementChild!.cloneNode(true) as HTMLElement;
    let run = 0, current: Scenario = scenarios[0];

    const set = (s: RunState) => { root.dataset.state = s; status.textContent = STATUS[s]; };
    function fill(sc: Scenario) {
      current = sc;
      q('[data-team]').textContent = sc.team; q('[data-title]').textContent = sc.draft.title;
      q('[data-meta]').textContent = sc.draft.meta; q('[data-body]').textContent = sc.draft.body;
      q('[data-act="approve"]').textContent = sc.draft.action;
      q('[data-sum]').textContent = `데이터 확인 ${sc.steps.filter(s => s.src !== '작성').length}번 · 초안 1건 · 사람 승인 1번`;
      steps.replaceChildren(...sc.steps.map(st => {
        const li = tpl.cloneNode(true) as HTMLElement; li.className = 'step'; li.dataset.st = 'wait';   // 서버가 그린 줄을 복제해야 스타일이 그대로 붙는다
        li.children[0].textContent = st.src; li.children[1].textContent = st.text; li.children[2].textContent = st.out;
        return li;
      }));
      tabs.forEach(t => t.setAttribute('aria-selected', String(t.dataset.scn === sc.id)));
      panel.setAttribute('aria-labelledby', `agent-tab-${sc.id}`);
    }
    async function play(sc: Scenario) {
      const me = ++run; fill(sc);
      const rows = Array.from(steps.children) as HTMLElement[];
      if (reduce) { ask.textContent = sc.ask; rows.forEach(r => (r.dataset.st = 'done')); set('awaiting'); return; }
      set('typing'); ask.textContent = '';
      for (const ch of sc.ask) { ask.textContent += ch; await wait(26); if (me !== run) return; }
      await wait(350); if (me !== run) return;
      set('working');
      for (const r of rows) {
        r.dataset.st = 'run'; r.classList.add('focus-mark');
        await wait(820); if (me !== run) return;
        r.dataset.st = 'done'; r.classList.remove('focus-mark');
        await wait(160); if (me !== run) return;
      }
      set('awaiting');
    }

    root.classList.add('live');
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => play(scenarios.find(s => s.id === t.dataset.scn)!));
      t.addEventListener('keydown', e => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0; if (!d) return;
        const n = tabs[(i + d + tabs.length) % tabs.length]; n.focus(); n.click();
      });
    });
    q('[data-act="replay"]').addEventListener('click', () => play(current));
    q('[data-act="approve"]').addEventListener('click', () => { if (root.dataset.state === 'awaiting') set('approved'); });
    q('[data-act="return"]').addEventListener('click', () => { if (root.dataset.state === 'awaiting') set('returned'); });

    // 화면에 들어오면 처음부터 한 번 재생한다.
    if (reduce) return;
    new IntersectionObserver(([e], io) => { if (e.isIntersecting) { io.disconnect(); play(scenarios[0]); } }, { threshold: 0.3 }).observe(root);
  });
</script>
