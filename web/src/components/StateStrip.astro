---
import { states } from '../data/site';
interface Props { detailed?: boolean }
const { detailed = false } = Astro.props;
---
<ol class={`strip ${detailed ? 'detailed' : ''}`} data-reveal="children">
  {states.map((s, i) => (
    <li class="st" id={detailed ? s.code.toLowerCase() : undefined}>
      <div class="top"><span class="n">{i + 1}단계</span><span class="code">{s.ko}</span><span class="meta">{s.duration} · {s.code}</span></div>
      {detailed && <ul class="items">{s.items.map(i => <li>{i}</li>)}</ul>}
      <p class="exit"><b>다음 단계로 가는 조건</b>{s.exit}</p>
    </li>
  ))}
</ol>
<p class="loop">운영에서 쌓인 데이터로 다음 개선 과제를 다시 진단합니다.</p>

<style>
  .strip { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid var(--edge); border-radius: 16px; overflow: hidden; }
  @media (max-width: 900px) { .strip { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .strip { grid-template-columns: 1fr; } }
  .strip.detailed { grid-template-columns: 1fr; }
  .st { padding: 24px; display: grid; gap: 14px; align-content: start; border-right: 1px solid var(--edge); border-bottom: 1px solid var(--edge); margin: 0 -1px -1px 0; }
  .detailed .st { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 16px 40px; padding: 32px; }
  @media (max-width: 760px) { .detailed .st { grid-template-columns: 1fr; padding: 24px; } }
  .detailed .exit { grid-column: 2; }
  @media (max-width: 760px) { .detailed .exit { grid-column: 1; } }
  .top { display: grid; gap: 6px; }
  .n { font: 500 12px var(--f-mono); color: var(--core); letter-spacing: .06em; }
  .code { font-weight: 700; font-size: clamp(28px, 3vw, 40px); line-height: 1.1; letter-spacing: -.03em; transition: color .3s; }
  .detailed .code { font-size: clamp(36px, 5vw, 56px); }
  .st:hover .code { color: var(--core); }
  .meta { font: 12px var(--f-mono); color: var(--ink-2); }
  .items { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .items li { padding-left: 18px; position: relative; }
  .items li::before { content: ""; position: absolute; left: 0; top: .7em; width: 8px; height: 8px; border: 1.5px solid var(--core); border-radius: 50%; }
  .exit { font-size: 14px; color: var(--ink-2); border-left: 2px solid var(--core); padding-left: 14px; }
  .exit b { display: block; font: 400 11.5px var(--f-mono); color: var(--core); letter-spacing: .06em; margin-bottom: 4px; }
  .loop { margin-top: 14px; font-size: 14px; color: var(--ink-2); }
</style>
