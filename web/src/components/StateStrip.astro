---
import { states } from '../data/site';
interface Props { detailed?: boolean }
const { detailed = false } = Astro.props;
---
<ol class={`strip ${detailed ? 'detailed' : ''}`} data-reveal="children">
  {states.map((s, i) => (
    <li class="st" id={detailed ? s.code.toLowerCase() : undefined}>
      <div class="top"><span class="n"><i></i>{i + 1}단계</span><span class="code">{s.ko}</span><span class="meta">{s.duration} · {s.code}</span></div>
      {detailed && <ul class="items">{s.items.map(i => <li>{i}</li>)}</ul>}
      <p class="exit"><b>다음 단계로 가는 조건</b>{s.exit}</p>
    </li>
  ))}
</ol>
<p class="loop">운영에서 쌓인 데이터로 다음 개선 과제를 다시 진단합니다.</p>

<style>
  .strip { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 900px) { .strip { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .strip { grid-template-columns: 1fr; } }
  .strip.detailed { grid-template-columns: 1fr; }
  .st { padding: 28px; display: grid; gap: 16px; align-content: start; border-radius: 24px; background: var(--surface); }
  .detailed .st { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 20px 48px; padding: clamp(24px, 3.4vw, 44px); }
  @media (max-width: 760px) { .detailed .st { grid-template-columns: 1fr; } }
  .detailed .exit { grid-column: 2; }
  @media (max-width: 760px) { .detailed .exit { grid-column: 1; } }
  .top { display: grid; gap: 6px; }
  .n { font-size: 14px; font-weight: 600; color: var(--core); }
  .n i { display: none; }
  .code { font-weight: 700; font-size: clamp(28px, 3vw, 40px); line-height: 1.15; letter-spacing: -.03em; }
  .detailed .code { font-size: clamp(34px, 4.4vw, 52px); }
  .meta { font-size: 14px; color: var(--ink-3); }
  .items { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; font-size: 17px; }
  .items li { padding-left: 26px; position: relative; }
  .items li::before { content: ""; position: absolute; left: 2px; top: .42em; width: 12px; height: 7px; border-left: 2px solid var(--core); border-bottom: 2px solid var(--core); rotate: -45deg; }
  .exit { font-size: 15px; color: var(--ink-2); background: var(--body); border-radius: 16px; padding: 16px 18px; }
  .exit b { display: block; font-size: 13px; font-weight: 600; color: var(--core); margin-bottom: 4px; }
  .loop { margin-top: 20px; font-size: 15px; color: var(--ink-2); }
</style>
