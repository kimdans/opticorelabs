---
// 첫 화면의 핵심 그림: 도입 전(엑셀·메신저·메모)과 도입 후(하나의 업무 화면)를 손잡이로 넘겨 본다.
// 두 화면 모두 설명을 위한 예시이며 실제 고객 화면이 아니다. 화면 안의 크기는 전부 em이라 창 폭에 맞춰 통째로 줄어든다.
const sheet = [
  ['품목', '수량', '단가', '금액', '담당', '비고'],
  ['베어링 6204', '1,200', '1,850', '2,220,000', '김대리', ''],
  ['오일씰 TC-35', '800', '2,400', '#REF!', '박과장', '단가 재확인'],
  ['샤프트 S45C', '150', '38,000', '5,700,000', '김대리', ''],
  ['커플링 CR-40', '??', '12,500', '', '', '재고 확인 필요'],
  ['베어링 6204', '1,200', '1,900', '2,280,000', '이사원', '중복?'],
  ['기어박스 G2', '24', '410,000', '9,840,000', '박과장', ''],
  ['볼트 M12 세트', '5,000', '120', '#VALUE!', '', ''],
  ['모터 0.75kW', '36', '185,000', '6,660,000', '김대리', '납기 11/28'],
  ['합계', '', '', '26,700,000?', '', '수식 깨짐'],
];
const flag: Record<string, string> = { '#REF!': 'err', '#VALUE!': 'err', '??': 'warn', '중복?': 'warn', '26,700,000?': 'warn' };
const chat = [
  { me: false, who: '박과장', t: '부장님 견적 결재 부탁드립니다' },
  { me: false, who: '이사원', t: '어제 올린 파일이 최종인가요?' },
  { me: true, who: '', t: '아니요, 그건 구버전입니다' },
  { me: false, who: '김대리', t: '베어링 재고 몇 개 남았죠?' },
  { me: true, who: '', t: '창고에 전화해 보겠습니다' },
];
const kpis = [
  { k: '이번 달 수주', v: '12.4억', d: '전월 대비 +8%' },
  { k: '결재 대기', v: '3건', d: '평균 처리 2시간' },
  { k: '재고 부족 품목', v: '2개', d: '자동 발주 제안됨' },
  { k: '월 마감', v: '86%', d: '예상 완료 11/30' },
];
const bars = [46, 58, 52, 71, 66, 88];
const approvals = [
  { t: '견적서 Q-2611-014', s: '대성기계 · 2,220만원' },
  { t: '구매 요청 P-2611-032', s: '오일씰 TC-35 800개' },
  { t: '출장비 정산', s: '영업1팀 · 38만원' },
];
const orders = [
  { no: 'SO-1128', c: '대성기계', a: '2,220만원', s: '출고 준비', tone: 'a' },
  { no: 'SO-1127', c: '한울정밀', a: '984만원', s: '생산 중', tone: 'b' },
  { no: 'SO-1126', c: '서진산업', a: '666만원', s: '완료', tone: 'c' },
];
const menu = ['대시보드', '견적·수주', '구매·발주', '재고', '회계·마감', '전자결재'];
---
<figure class="cmp" data-compare>
  <div class="win" style="--p:.5">
    <div class="mock after">
      <aside class="side">
        <p class="app"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="3.2"/><rect x="8.4" y="8.4" width="7.2" height="7.2" rx="1.4" fill="var(--core)"/></svg>통합 업무</p>
        <ul>{menu.map((m, i) => <li class={i === 0 ? 'on' : ''}><i></i>{m}</li>)}</ul>
        <p class="ai-link"><i></i>AI 업무비서</p>
      </aside>
      <div class="main">
        <div class="top"><b>대시보드</b><span>11월 3주차</span><em>옵티코어 이후</em></div>
        <ul class="kpis">{kpis.map(x => <li><span>{x.k}</span><b>{x.v}</b><small>{x.d}</small></li>)}</ul>
        <div class="row">
          <section class="card chart">
            <h4>수주 추이 <span>최근 6개월</span></h4>
            <div class="bars">{bars.map((b, i) => <i style={`--h:${b}%`} class={i === bars.length - 1 ? 'now' : ''}></i>)}</div>
          </section>
          <section class="card appr">
            <h4>결재 대기 <span>3</span></h4>
            <ul>{approvals.map(a => <li><div><b>{a.t}</b><small>{a.s}</small></div><em>승인</em></li>)}</ul>
          </section>
        </div>
        <section class="card orders">
          <h4>최근 주문</h4>
          <ul>{orders.map(o => <li><b>{o.no}</b><span>{o.c}</span><span class="amt">{o.a}</span><em class={o.tone}>{o.s}</em></li>)}</ul>
        </section>
      </div>
      <p class="assist"><i></i><span><b>AI 업무비서</b>대성기계 발주가 평소보다 12% 늘었습니다. 베어링 6204 추가 발주를 올릴까요?</span></p>
    </div>

    <div class="mock before" aria-hidden="true">
      <em class="tag">지금</em>
      <div class="w xls back"><p class="tb"><i></i>재고현황_10월(수정).xlsx</p></div>
      <div class="w xls">
        <p class="tb"><i></i>견적서_최종_진짜최종(3).xlsx</p>
        <div class="grid">{sheet.map((r, ri) => r.map(c => <span class={`${ri === 0 ? 'h' : ''} ${flag[c] ?? ''} ${ri === sheet.length - 1 ? 'sum' : ''}`}>{c}</span>))}</div>
      </div>
      <div class="w chat">
        <p class="tb"><i></i>영업팀 단체방 (12)</p>
        <ul>{chat.map(c => <li class={c.me ? 'me' : ''}>{c.who && <small>{c.who}</small>}<span>{c.t}</span></li>)}</ul>
      </div>
      <p class="note">월말 마감!!<br />재고 수량은<br />김대리에게 확인</p>
      <p class="mail"><b>받은편지함 48</b>세금계산서_11월.pdf 외 3건</p>
    </div>

    <input type="range" min="0" max="100" value="50" step="0.1" id="compare-range"
      aria-label="도입 전후 비교. 왼쪽은 지금의 엑셀과 메신저, 오른쪽은 옵티코어 도입 이후의 통합 업무 화면" />
    <div class="divider" aria-hidden="true"><span class="knob"><svg viewBox="0 0 24 24"><path d="M9 6l-5 6 5 6M15 6l5 6-5 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div>
  </div>
  <figcaption>손잡이를 좌우로 움직여 보세요. 설명을 위한 예시 화면입니다.</figcaption>
</figure>

<style>
  .cmp { margin: 0; padding: clamp(14px, 3.6vw, 52px); padding-bottom: 0; border-radius: clamp(20px, 2.6vw, 36px); display: grid; gap: 0;
         background: radial-gradient(90% 120% at 12% 0%, #DCE0FF 0%, transparent 60%), radial-gradient(80% 110% at 100% 100%, #CFE7FF 0%, transparent 62%), #EEF0F7; }
  figcaption { font-size: 14px; color: var(--ink-2); text-align: center; padding-block: 16px 18px; }

  /* 창: 손잡이 위치 --p(0~1)는 스크립트가 바꾼다. --x는 손잡이의 가로 위치(손잡이 폭 44px 보정). */
  .win { --x: calc(22px + (100% - 44px) * var(--p)); position: relative; aspect-ratio: 16 / 10; border-radius: clamp(10px, 1.2vw, 16px); overflow: hidden; container-type: inline-size; background: #fff;
         box-shadow: 0 1px 0 rgba(12, 16, 22, .04), 0 24px 60px -20px rgba(26, 35, 176, .28), 0 8px 20px -12px rgba(12, 16, 22, .2); }
  @media (max-width: 700px) { .win { aspect-ratio: 5 / 6; } }
  .mock { position: absolute; inset: 0; font-size: 1.19cqw; line-height: 1.4; letter-spacing: -.01em; color: #1A202B; }
  @container (max-width: 600px) { .mock { font-size: 2.95cqw; } }
  .mock :global(ul) { list-style: none; margin: 0; padding: 0; }
  .mock :global(p), .mock :global(h4) { margin: 0; }
  .before { clip-path: inset(0 calc(100% - var(--x)) 0 0); }

  /* ── 이후: 하나의 업무 화면 ── */
  .after { display: grid; grid-template-columns: 15em minmax(0, 1fr); background: #fff; }
  .side { background: #F6F7FA; border-right: 1px solid #E8EBF0; padding: 1.5em 1em; display: grid; align-content: start; gap: 1.6em; }
  .app { display: flex; align-items: center; gap: .55em; font-weight: 700; font-size: 1.1em; padding-left: .5em; }
  .app svg { width: 1.5em; height: 1.5em; }
  .side li, .ai-link { display: flex; align-items: center; gap: .7em; padding: .65em .8em; border-radius: .6em; color: #5B6472; font-weight: 500; }
  .side li i, .ai-link i { width: .95em; height: .95em; border-radius: .28em; background: #CBD1DA; }
  .side li.on { background: #fff; color: #0C1016; font-weight: 600; box-shadow: 0 1px 2px rgba(12, 16, 22, .08); }
  .side li.on i, .ai-link i { background: var(--core); }
  .ai-link { color: var(--core); font-weight: 600; background: var(--core-soft); }
  .main { padding: 1.5em 1.9em; display: grid; grid-template-rows: auto auto minmax(0, 1.25fr) minmax(0, 1fr); gap: 1.1em; min-width: 0; }
  .top { display: flex; align-items: baseline; gap: .9em; }
  .top b { font-size: 1.55em; font-weight: 700; letter-spacing: -.03em; }
  .top span { color: #8D96A3; }
  .top em, .tag { font-style: normal; font-weight: 600; font-size: .95em; padding: .35em .9em; border-radius: 99em; }
  .top em { margin-left: auto; background: var(--core); color: #fff; }
  .kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1em; }
  .kpis li, .card { border: 1px solid #E8EBF0; border-radius: 1em; background: #fff; }
  .kpis li { padding: 1em 1.15em; display: grid; gap: .15em; }
  .kpis span { color: #5B6472; font-size: .92em; }
  .kpis b { font-size: 1.85em; font-weight: 700; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
  .kpis small { color: #0B8F62; font-size: .85em; font-weight: 500; }
  .row { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 1em; min-height: 0; }
  .card { padding: 1.15em 1.25em; display: grid; grid-template-rows: auto minmax(0, 1fr); gap: .8em; min-height: 0; }
  .card h4 { font-size: 1.05em; font-weight: 600; display: flex; gap: .6em; align-items: baseline; }
  .card h4 span { color: #8D96A3; font-weight: 500; font-size: .88em; }
  .appr h4 span { color: #fff; background: var(--core); border-radius: 99em; padding: 0 .55em; }
  .bars { display: flex; align-items: flex-end; gap: 6%; padding-inline: 2%; border-bottom: 1px solid #E8EBF0; }
  .bars i { flex: 1; height: var(--h); border-radius: .5em .5em 0 0; background: #DDE1FF; transform-origin: bottom; }
  .bars i.now { background: var(--core); }
  .appr ul { display: grid; align-content: space-between; }
  .appr li { display: flex; justify-content: space-between; align-items: center; gap: .8em; }
  .appr li div { display: grid; min-width: 0; }
  .appr b { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .appr small { color: #8D96A3; font-size: .85em; }
  .appr em { font-style: normal; font-weight: 600; font-size: .9em; color: var(--core); background: var(--core-soft); padding: .4em .9em; border-radius: 99em; }
  .orders ul { display: grid; align-content: space-around; }
  .orders li { display: grid; grid-template-columns: 6em minmax(0, 1fr) 7em 6.5em; align-items: center; gap: 1em; }
  .orders b { font-weight: 600; font-variant-numeric: tabular-nums; }
  .orders span { color: #5B6472; }
  .orders .amt { text-align: right; font-variant-numeric: tabular-nums; }
  .orders em { font-style: normal; font-size: .85em; font-weight: 600; padding: .3em 0; border-radius: 99em; text-align: center; }
  .orders em.a { background: #EDEFFF; color: var(--core); }
  .orders em.b { background: #FFF3DC; color: #9A6100; }
  .orders em.c { background: #E3F6EE; color: #0B8F62; }
  .assist { position: absolute; right: 1.6em; bottom: 1.6em; width: 23em; display: flex; gap: .8em; padding: 1em 1.1em; border-radius: 1.1em; background: #0C1016; color: #F4F6F8; box-shadow: 0 1.2em 2.4em -1em rgba(12, 16, 22, .5); }
  .assist i { flex: none; width: 1.9em; height: 1.9em; border-radius: 50%; background: var(--core); box-shadow: inset 0 0 0 .5em #0C1016, inset 0 0 0 .62em #F4F6F8; }
  .assist span { font-size: .93em; color: #C5CBD5; }
  .assist b { display: block; color: #fff; font-weight: 600; }
  @container (max-width: 600px) {
    .after { grid-template-columns: 1fr; }
    .side, .orders, .chart { display: none; }
    .main { padding: 1.3em; grid-template-rows: auto auto minmax(0, 1fr); }
    .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8em; }
    .row { grid-template-columns: 1fr; padding-bottom: 8em; }
    .assist { left: 1.3em; right: 1.3em; bottom: 1.3em; width: auto; }
  }

  /* ── 지금: 엑셀, 메신저, 메모가 따로 논다 ── */
  .before { background: linear-gradient(160deg, #D9DDE4, #BFC5CF); filter: saturate(.82); }
  .tag { position: absolute; left: 1.5em; top: 1.3em; z-index: 5; background: #0C1016; color: #fff; }
  .w { position: absolute; background: #fff; border-radius: .7em; overflow: hidden; box-shadow: 0 1.4em 3em -1.2em rgba(12, 16, 22, .45), 0 0 0 1px rgba(12, 16, 22, .08); }
  .tb { display: flex; align-items: center; gap: .6em; padding: .6em .9em; font-size: .9em; font-weight: 500; color: #fff; white-space: nowrap; }
  .tb i { width: .8em; height: .8em; border-radius: .2em; background: rgba(255, 255, 255, .7); flex: none; }
  .xls { left: 4%; top: 15%; width: 61%; rotate: -1.4deg; }
  .xls .tb { background: #1D6F42; }
  .xls.back { left: 12%; top: 7%; width: 50%; height: 30%; rotate: 2deg; opacity: .9; }
  .grid { display: grid; grid-template-columns: 1.5fr .8fr .9fr 1.2fr .9fr 1.4fr; font-size: .88em; font-variant-numeric: tabular-nums; }
  .grid span { padding: .5em .65em; border-right: 1px solid #DDE1E6; border-bottom: 1px solid #DDE1E6; white-space: nowrap; overflow: hidden; min-height: 2.3em; }
  .grid .h { background: #EEF1F4; font-weight: 600; color: #4A5360; }
  .grid .err { color: #C0221A; background: #FDE8E6; font-weight: 600; }
  .grid .warn { background: #FFF1B8; }
  .grid .sum { font-weight: 700; background: #F6F7F9; }
  .grid .sum.warn { background: #FFF1B8; }
  .chat { left: 25%; top: 47%; width: 27%; rotate: 2deg; z-index: 2; }
  .chat .tb { background: #3A4250; }
  .chat ul { display: grid; gap: .7em; padding: 1em; background: #B9C7D6; }
  .chat li { display: grid; justify-items: start; gap: .15em; }
  .chat li small { font-size: .78em; color: #3A4250; }
  .chat li span { background: #fff; padding: .5em .8em; border-radius: .2em .9em .9em .9em; font-size: .92em; max-width: 92%; }
  .chat li.me { justify-items: end; }
  .chat li.me span { background: #FFE14D; border-radius: .9em .2em .9em .9em; }
  .note { position: absolute; left: 7%; bottom: 17%; z-index: 3; rotate: -5deg; background: #FFE98A; padding: 1em 1.2em 1.6em; font-weight: 600; line-height: 1.5; box-shadow: 0 .8em 1.4em -.6em rgba(12, 16, 22, .4); }
  .mail { position: absolute; left: 57%; top: 12%; z-index: 3; background: #fff; border-radius: .8em; padding: .8em 1.1em; display: grid; font-size: .92em; color: #5B6472; box-shadow: 0 1em 2em -1em rgba(12, 16, 22, .45); border-left: .3em solid #D4281C; }
  .mail b { color: #0C1016; }
  @container (max-width: 600px) {
    .xls { left: 4%; top: 13%; width: 118%; }
    .xls.back { display: none; }
    .chat { left: 30%; top: 46%; width: 74%; }
    .note { left: 6%; bottom: 20%; }
    .mail { display: none; }
  }

  /* ── 손잡이 ── */
  input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; touch-action: pan-y; z-index: 6; -webkit-appearance: none; appearance: none; background: transparent; }
  input::-webkit-slider-thumb { -webkit-appearance: none; width: 44px; height: 100vh; }
  input::-moz-range-thumb { width: 44px; height: 100vh; border: 0; }
  .divider { position: absolute; top: 0; bottom: 0; left: var(--x); width: 2px; margin-left: -1px; background: #fff; box-shadow: 0 0 0 1px rgba(12, 16, 22, .12); z-index: 4; pointer-events: none; }
  .knob { position: absolute; left: 50%; top: 50%; width: 48px; height: 48px; margin: -24px 0 0 -24px; border-radius: 50%; background: #fff; color: #0C1016; display: grid; place-items: center; box-shadow: 0 6px 20px -4px rgba(12, 16, 22, .4), 0 0 0 1px rgba(12, 16, 22, .08); transition: scale .25s var(--ease); }
  .knob svg { width: 22px; height: 22px; }
  .win:hover .knob { scale: 1.08; }
  input:focus-visible + .divider .knob { outline: 3px solid var(--core); outline-offset: 3px; }
  @media (max-width: 700px) { .knob { width: 40px; height: 40px; margin: -20px 0 0 -20px; } }
</style>

<script>
  import { reduceMotion } from '../scripts/reveal';

  // 상태는 둘뿐이다: demo(처음 한 번 스스로 넘겨 보여 주는 중) → user(방문자가 손잡이를 잡은 뒤). user가 되면 다시 demo로 돌아가지 않는다.
  type CompareState = 'demo' | 'user';
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach(root => {
    const win = root.querySelector<HTMLElement>('.win')!, range = root.querySelector<HTMLInputElement>('input')!;
    let state: CompareState = 'demo';
    const set = (v: number) => { win.style.setProperty('--p', (v / 100).toFixed(4)); };
    range.addEventListener('input', () => { state = 'user'; root.dataset.state = state; set(+range.value); });
    if (reduceMotion()) return;

    // 화면에 들어오면 "지금" 쪽을 넓게 보여 줬다가 "이후" 쪽으로 한 번 넘긴다.
    const FROM = 88, TO = 50, MS = 1700;
    set(FROM); range.value = String(FROM);
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const t0 = performance.now() + 500;
      const tick = (now: number) => {
        if (state !== 'demo') return;
        const t = Math.min(1, Math.max(0, (now - t0) / MS)), k = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        const v = FROM + (TO - FROM) * k; set(v); range.value = String(v);
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, { threshold: 0.35 });
    io.observe(win);
  });
</script>
