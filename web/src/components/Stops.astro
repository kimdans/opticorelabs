---
import { principles } from '../data/site';
---
<ol class="stoplist" data-reveal="children">
  {principles.map(p => (
    <li class="stop"><span class="f">{p.stop}</span><h3>{p.title}</h3><p>{p.body}</p></li>
  ))}
</ol>

<style>
  .stoplist { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .stop { display: grid; grid-template-columns: 120px minmax(0, 1fr) minmax(0, 1.3fr); gap: 24px; padding-block: 24px; border-bottom: 1px solid var(--line); align-items: baseline; transition: background .3s; }
  @media (max-width: 760px) { .stop { grid-template-columns: 76px minmax(0, 1fr); } .stop p { grid-column: 2; } }
  .f { font-family: var(--f-mono); font-size: 22px; color: var(--ink-2); transition: color .3s; font-variant-numeric: tabular-nums; }
  h3 { font-size: 20px; }
  p { color: var(--ink-2); }
  .stop:hover .f { color: var(--core); }
  .stop:hover { background: linear-gradient(90deg, color-mix(in srgb, var(--core) 8%, transparent), transparent 70%); }
</style>
