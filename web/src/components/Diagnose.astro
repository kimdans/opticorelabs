---
import { SIZES, PAINS, SYSTEMS } from '../lib/diagnose';
import { company } from '../data/site';

// bare: 바깥에서 섹션 제목을 이미 보여줄 때 (홈). 아니면 화면 낭독기용 제목을 단다.
interface Props { bare?: boolean }
const { bare = false } = Astro.props;
const groups = [
  { name: 'size', legend: '회사 규모', opts: SIZES },
  { name: 'pain', legend: '가장 아픈 곳', opts: PAINS },
  { name: 'systems', legend: '지금 쓰는 시스템', opts: SYSTEMS },
] as const;
---
<div class="diag" data-state="idle" id="diagnose">
  {!bare && <h2 class="sr-only">진단</h2>}

  <div class="grid">
    <form class="questions" data-answers>
      {groups.map((g, gi) => (
        <fieldset>
          <legend>{g.legend}</legend>
          <div class="opts">
            {Object.entries(g.opts).map(([value, label], i) => (
              <>
                <input type="radio" name={g.name} id={`${g.name}-${value}`} value={value} />
                <label for={`${g.name}-${value}`}>{label}</label>
              </>
            ))}
          </div>
        </fieldset>
      ))}
    </form>

    <div class="result" aria-live="polite">
      <div class="top">
        <div class="txt">
          <span class="eyebrow">추천 시작 단계</span>
          <p class="idle-msg" data-when="idle">세 가지를 고르면 어디서부터 시작하면 좋을지, 어떤 서비스가 맞는지 여기에 나옵니다.</p>
          <div class="rec" data-when="result contact submitting submitted failed copied">
            <span class="st"><span data-out="state"></span> <small data-out="code"></small></span>
            <p class="lens">추천 서비스: <b data-out="lens"></b></p>
            <p class="why" data-out="reason"></p>
          </div>
        </div>
        <div class="meter" aria-hidden="true"><i></i><i></i><i></i></div>
        <p class="count"><b data-out="count">0</b> / 3 선택</p>
      </div>

      <div class="actions" data-when="result copied">
        <button class="btn" type="button" data-act="contact">이 결과로 상담 요청</button>
        <button class="btn ghost" type="button" data-act="copy">결과 복사</button>
      </div>

      <form class="contact" data-contact data-when="contact submitting failed" novalidate>
        <div class="field"><label for="c-company">회사명</label><input id="c-company" name="company" autocomplete="organization" required /></div>
        <div class="field"><label for="c-name">이름</label><input id="c-name" name="name" autocomplete="name" required /></div>
        <div class="field"><label for="c-reach">이메일 또는 전화</label><input id="c-reach" name="reach" autocomplete="email" required /></div>
        <div class="hp" aria-hidden="true"><label for="c-web">웹사이트</label><input id="c-web" name="website" tabindex="-1" autocomplete="off" /></div>
        <label class="consent"><input type="checkbox" name="consent" required /> 상담을 위해 회사명·이름·연락처를 수집하고 1년 뒤 파기하는 데 동의합니다. (문구는 법무 검토 전 예시)</label>
        <p class="err" data-out="error" role="alert"></p>
        <div class="actions">
          <button class="btn" type="submit" data-act="submit">보내기</button>
          <button class="btn ghost" type="button" data-act="copy">대신 복사하기</button>
        </div>
      </form>

      <p class="msg ok" data-when="submitted">보냈습니다. 담당자가 영업일 기준 1일 안에 연락드립니다.</p>
      <p class="msg" data-when="copied" data-out="copied">복사했습니다. {company.email} 로 보내 주세요.</p>
      <textarea class="sr-only" data-out="summary" readonly aria-hidden="true" tabindex="-1"></textarea>
    </div>
  </div>
</div>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
  fieldset { border: 0; padding: 0; margin: 0 0 32px; }
  legend { font-weight: 700; font-size: 19px; margin-bottom: 14px; padding: 0; }
  .opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .opts input { position: absolute; opacity: 0; pointer-events: none; }
  .opts label { cursor: pointer; border-radius: 999px; padding: 12px 20px; font-size: 16px; font-weight: 500; background: var(--surface); color: var(--ink); transition: background .2s, color .2s, transform .2s var(--ease); }
  .opts label:hover { box-shadow: inset 0 0 0 1.5px var(--ink); }
  .opts input:checked + label { background: var(--ink); color: var(--body); }
  .opts input:focus-visible + label { outline: 2px solid var(--core); outline-offset: 2px; }

  .result { border-radius: 28px; padding: clamp(24px, 3vw, 40px); display: grid; gap: 16px; background: var(--surface); transition: background .5s, color .5s; }
  @media (min-width: 901px) { .result { position: sticky; top: 100px; } }
  .diag:not([data-state="idle"]) .result { background: var(--night); color: var(--on-night); --muted: var(--on-night-2); }
  .top { display: grid; gap: 16px; }
  .txt { display: grid; gap: 12px; order: 3; }
  /* 고른 문항 수만큼 칸이 찬다 (data-n은 스크립트가 넣는다) */
  .meter { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; order: 1; }
  .meter i { height: 4px; border-radius: 999px; background: color-mix(in srgb, currentColor 14%, transparent); transition: background .4s; }
  .diag[data-n="1"] .meter i:nth-child(-n+1), .diag[data-n="2"] .meter i:nth-child(-n+2), .diag[data-n="3"] .meter i { background: var(--core); }
  .diag[data-n="3"] .meter i { background: #8089FF; }
  .count { order: 2; font-size: 14px; color: var(--muted, var(--ink-2)); font-variant-numeric: tabular-nums; }
  .count b { font-weight: 600; color: inherit; }
  .eyebrow { color: var(--muted, var(--core)); }
  .diag:not([data-state="idle"]) .eyebrow { color: #A5ACFF; }
  .st { font-weight: 700; font-size: clamp(34px, 3.6vw, 48px); line-height: 1.2; letter-spacing: -.04em; }
  .st small { font-size: 14px; font-weight: 500; color: var(--muted, var(--ink-3)); letter-spacing: 0; vertical-align: middle; }
  .rec { display: grid; gap: 12px; animation: result-in .6s var(--ease); }
  @keyframes result-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .idle-msg { color: var(--ink-2); font-size: 17px; }
  .lens { font-size: 17px; }
  .lens b { font-weight: 700; }
  .why { color: var(--muted, var(--ink-2)); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .diag:not([data-state="idle"]) .result :global(.btn) { background: #fff; color: var(--night); }
  .diag:not([data-state="idle"]) .result :global(.btn.ghost) { background: var(--night-2); color: var(--on-night); box-shadow: none; }
  .contact { display: grid; gap: 14px; border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent); padding-top: 20px; margin-top: 4px; }
  .field { display: grid; gap: 6px; }
  .field label { font-size: 14px; color: var(--muted, var(--ink-2)); }
  .field input { font: inherit; color: var(--on-night); background: var(--night-2); border: 1px solid transparent; border-radius: 12px; padding: 13px 14px; }
  .field input:focus-visible { outline: none; border-color: #8C95FF; }
  .consent { font-size: 13.5px; color: var(--muted, var(--ink-2)); display: flex; gap: 8px; align-items: flex-start; }
  .consent input { margin-top: 4px; accent-color: #8C95FF; }
  .hp { position: absolute; left: -9999px; }
  .err { color: #FF8A80; font-size: 14.5px; min-height: 0; }
  .err:empty { display: none; }
  .msg { font-size: 16px; white-space: pre-wrap; }
  .msg.ok { color: #6EE7B7; }

  /* 상태별 표시: data-when 목록에 현재 상태가 있을 때만 보인다. 불가능한 조합(전송 중 + 완료)이 화면에 나오지 않는다. */
  [data-when] { display: none; }
  .diag[data-state="idle"] [data-when~="idle"],
  .diag[data-state="result"] [data-when~="result"],
  .diag[data-state="contact"] [data-when~="contact"],
  .diag[data-state="submitting"] [data-when~="submitting"],
  .diag[data-state="submitted"] [data-when~="submitted"],
  .diag[data-state="failed"] [data-when~="failed"],
  .diag[data-state="copied"] [data-when~="copied"] { display: revert; }
  .diag[data-state="result"] .actions[data-when], .diag[data-state="copied"] .actions[data-when] { display: flex; }
  .diag[data-state="contact"] .contact, .diag[data-state="submitting"] .contact, .diag[data-state="failed"] .contact { display: grid; }
  .diag:not([data-state="idle"]) .rec { display: grid; }
</style>

<script>
  import { recommend, summaryText, next, SUBMIT_TIMEOUT_MS, type Answers, type FlowEvent, type FlowState } from '../lib/diagnose';
  import { track } from '../scripts/track';

  const ENDPOINT = import.meta.env.PUBLIC_DIAGNOSE_ENDPOINT as string | undefined;

  document.querySelectorAll<HTMLElement>('.diag').forEach(root => {
    const answers = root.querySelector<HTMLFormElement>('[data-answers]')!;
    const contact = root.querySelector<HTMLFormElement>('[data-contact]')!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const submitBtn = root.querySelector<HTMLButtonElement>('[data-act="submit"]')!;
    let state = root.dataset.state as FlowState;
    let started = false;

    // 고른 문항 수(0~3)를 진행 표시에 반영한다.
    const answered = () => ['size', 'pain', 'systems'].filter(n => answers.querySelector(`input[name="${n}"]:checked`)).length;
    const focus = (n: number) => { root.dataset.n = String(n); out('count').textContent = String(n); };
    focus(0);

    const KO: Record<string, string> = { SCAN: '진단', FOCUS: '설계', BUILD: '구축', RUN: '운영' };
    const complete = () => ['size', 'pain', 'systems'].every(n => answers.querySelector(`input[name="${n}"]:checked`));
    const read = (): Answers => Object.fromEntries(new FormData(answers)) as unknown as Answers;
    function send(e: FlowEvent) {
      const to = next(state, e);
      if (to === state && e !== 'ANSWER') return state;
      state = to; root.dataset.state = to;
      submitBtn.disabled = to === 'submitting';
      submitBtn.textContent = to === 'submitting' ? '보내는 중…' : to === 'failed' ? '다시 시도' : '보내기';
      return to;
    }
    function render() {
      const a = read(), r = recommend(a);
      out('state').textContent = `${KO[r.start_state]}부터 시작`;
      out('code').textContent = r.start_state;
      out('lens').textContent = r.lens.join(' + ');
      out('reason').textContent = r.reason;
      (out('summary') as HTMLTextAreaElement).value = summaryText(a, r);
      track('diagnose_result_shown', { start_state: r.start_state, lens: r.lens.join('+') });
      return r;
    }

    answers.addEventListener('change', () => {
      if (!started) { started = true; track('diagnose_started', { from: location.pathname }); }
      if (!complete()) { focus(answered()); return; }   // 세 문항을 다 고르기 전에는 결과를 보이지 않는다
      send('ANSWER'); render(); focus(3);
    });
    root.querySelector('[data-act="contact"]')?.addEventListener('click', () => {
      send('START_CONTACT');
      root.querySelector<HTMLInputElement>('#c-company')?.focus();
    });
    root.querySelectorAll('[data-act="copy"]').forEach(b => b.addEventListener('click', async () => {
      const ta = out('summary') as HTMLTextAreaElement;
      let ok = true;
      try { await navigator.clipboard.writeText(ta.value); } catch { ok = false; }
      if (!ok) out('copied').textContent = '복사가 막혀 있습니다. 아래 내용을 직접 보내 주세요.\n' + ta.value;
      send('COPY'); track('diagnose_copy', { ok });
    }));

    contact.addEventListener('submit', async ev => {
      ev.preventDefault();
      const err = out('error'); err.textContent = '';
      const data = Object.fromEntries(new FormData(contact)) as Record<string, string>;
      if (data.website) return; // 스팸 봇
      if (!data.company || !data.name || !data.reach) { err.textContent = '회사명, 이름, 연락처를 모두 입력해 주세요.'; return; }
      if (!data.consent) { err.textContent = '개인정보 수집에 동의해야 보낼 수 있습니다.'; return; }
      if (state !== 'contact' && state !== 'failed') return;
      send(state === 'failed' ? 'RETRY' : 'SUBMIT');
      try {
        if (!ENDPOINT) throw new Error('not-configured');
        const ctrl = new AbortController(); const t = setTimeout(() => ctrl.abort(), SUBMIT_TIMEOUT_MS);
        const a = read();
        const res = await fetch(ENDPOINT, { method: 'POST', headers: { 'content-type': 'application/json' }, signal: ctrl.signal,
          body: JSON.stringify({ answers: a, recommendation: recommend(a), contact: { company: data.company, name: data.name, reach: data.reach } }) });
        clearTimeout(t);
        if (!res.ok) throw new Error('http-' + res.status);
        send('SUCCESS'); track('diagnose_submitted', { start_state: recommend(a).start_state });
      } catch (e) {
        send('ERROR');
        err.textContent = (e as Error).message === 'not-configured'
          ? '온라인 전송은 아직 준비 중입니다. "대신 복사하기"로 내용을 복사해 메일로 보내 주세요.'
          : '보내지 못했습니다. 다시 시도하거나 내용을 복사해 메일로 보내 주세요.';
      }
    });

  });
</script>
