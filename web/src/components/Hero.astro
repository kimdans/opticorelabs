---
import { url } from '../lib/paths';
import AgentRun from './AgentRun.astro';
---
<!-- 첫 화면: AX 전문이라는 것을 말로 밝히고, 바로 아래에서 에이전트가 일하는 장면을 보여 준다. -->
<section class="hero gut" aria-labelledby="hero-title">
  <div class="inner">
    <div class="head">
      <div class="title">
        <p class="kicker"><i></i>AX · AI 전환 전문 구축팀 옵티코어</p>
        <h1 id="hero-title"><span class="w" style="--i:0">흐릿한</span> <span class="w" style="--i:1">업무를</span> <span class="w" style="--i:2">선명하게,</span><br /><span class="w" style="--i:3">그다음</span> <em><span class="w" style="--i:4">AI에게</span> <span class="w" style="--i:5">맡깁니다</span></em></h1>
      </div>
      <div class="sub">
        <p>엑셀과 메신저에 흩어진 업무를 하나의 시스템으로 정리하고, 그 위에 사람이 승인하는 업무 에이전트를 올립니다. 진단부터 운영까지 한 팀이 맡습니다.</p>
        <div class="cta">
          <a class="btn core" href={url('/diagnose')}>3문항으로 진단하기</a>
          <a class="btn ghost" href={url('/lenses/ax')}>AI 전환 서비스 보기</a>
        </div>
      </div>
    </div>
    <div class="visual"><AgentRun /></div>
  </div>
</section>

<style>
  .hero { padding-block: 140px 24px; }
  @media (max-width: 760px) { .hero { padding-block: 100px 16px; } }
  .head { display: grid; gap: 32px; margin-bottom: clamp(36px, 4.6vw, 64px); }
  .title { display: grid; gap: 22px; }
  .kicker { display: flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 600; }
  .kicker i { width: 10px; height: 10px; border-radius: 3px; background: var(--core); }
  h1 { font-size: clamp(36px, 5.6vw, 80px); font-weight: 700; line-height: 1.18; letter-spacing: -.045em; }
  h1 em { font-style: normal; color: var(--core); }
  /* 브랜드 모티프 "초점 맞추기": 단어가 흐린 상태에서 차례로 선명해진다 (CSS만 사용) */
  .w { display: inline-block; animation: focus-in .8s var(--ease) both; animation-delay: calc(var(--i) * 70ms + 60ms); }
  @keyframes focus-in { from { filter: blur(.18em); opacity: 0; } to { filter: blur(0); opacity: 1; } }
  .sub { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 24px 48px; animation: fade .9s var(--ease) .4s both; }
  .sub p { font-size: clamp(16px, 1.4vw, 19px); color: var(--ink-2); max-width: 33em; flex: 1 1 22em; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; }
  .visual { animation: fade 1s var(--ease) .5s both; }
  @keyframes fade { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
</style>
