---
import { url } from '../lib/paths';
import Swarm from './Swarm.astro';
---
<!-- 첫 화면: 한 문장의 주장 + 한 줄 설명 + 버튼 하나. 나머지 설명은 오른쪽 스웜이 그림으로 한다. -->
<section class="hero gut" aria-labelledby="hero-title">
  <div class="inner wrap">
    <div class="copy">
      <p class="kicker"><i></i>AX · AI 전환 컨설팅·구축</p>
      <h1 id="hero-title"><span class="w" style="--i:0">흐릿한</span> <span class="w" style="--i:1">업무를</span> <span class="w" style="--i:2">선명하게,</span><br /><span class="w" style="--i:3">그다음</span> <em><span class="w" style="--i:4">AI에게</span> <span class="w" style="--i:5">맡깁니다</span></em></h1>
      <p class="sub">업무를 시스템으로 정리하고, 그 위에 사람이 승인하는 업무 에이전트를 올립니다.</p>
      <div class="cta">
        <a class="btn core" href={url('/diagnose')}>3문항으로 진단하기</a>
        <a class="more" href="#agent">AI가 일하는 모습 보기<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      </div>
    </div>
    <Swarm />
  </div>
</section>

<style>
  .hero { padding-block: 132px 72px; overflow-x: clip; }   /* 스웜 캔버스가 무대보다 넓어서 좁은 화면에서 옆으로 넘치지 않게 자른다 */
  @media (max-width: 760px) { .hero { padding-block: 96px 48px; } }
  .wrap { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 40px 56px; align-items: center; }
  @media (max-width: 940px) { .wrap { grid-template-columns: 1fr; } }
  .copy { display: grid; gap: 24px; justify-items: start; min-width: 0; }
  .kicker { display: flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 600; }
  .kicker i { width: 10px; height: 10px; border-radius: 3px; background: var(--core); }
  h1 { font-size: clamp(36px, 4.7vw, 68px); font-weight: 700; line-height: 1.16; letter-spacing: -.05em; }
  h1 em { font-style: normal; color: var(--core); }
  /* 브랜드 모티프 "초점 맞추기": 단어가 흐린 상태에서 차례로 선명해진다 (CSS만 사용) */
  .w { display: inline-block; animation: focus-in .8s var(--ease) both; animation-delay: calc(var(--i) * 70ms + 60ms); }
  @keyframes focus-in { from { filter: blur(.18em); opacity: 0; } to { filter: blur(0); opacity: 1; } }
  .sub { font-size: clamp(17px, 1.5vw, 20px); color: var(--ink-2); max-width: 24em; animation: fade .9s var(--ease) .4s both; }
  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; animation: fade .9s var(--ease) .5s both; }
  .more { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 16px; text-decoration: none; padding-block: 12px; }
  .more svg { width: 18px; height: 18px; transition: translate .25s var(--ease); }
  .more:hover svg { translate: 0 3px; }
  @keyframes fade { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
</style>
