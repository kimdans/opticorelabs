---
import { url } from '../lib/paths';
import FocusField from './FocusField.astro';
---
<!-- 첫 화면: 왼쪽은 누가 무엇을 하는지, 오른쪽은 그 일을 직접 해 보는 초점 체험.
     제목 첫 줄("흐릿한 업무를")은 오른쪽 업무가 정리될수록 선명해진다 (--messy: 1 → 0, FocusField가 바꾼다). -->
<section class="hero gut" aria-labelledby="hero-title">
  <div class="inner wrap">
    <div class="copy">
      <p class="eyebrow">SI · ERP · AX · SaaS</p>
      <h1 id="hero-title">
        <span class="soft"><span class="w" style="--i:0">흐릿한</span> <span class="w" style="--i:1">업무를</span></span><br />
        <em><span class="w" style="--i:2">선명한</span> <span class="w" style="--i:3">시스템</span></em><span class="w" style="--i:4">으로.</span>
      </h1>
      <p class="lede">직원 30~200명 규모 회사의 엑셀·메신저 결재·수작업을 하나의 시스템으로 정리합니다. 진단부터 구축, 운영까지 한 팀이 맡습니다.</p>
      <div class="cta">
        <a class="btn" href={url('/diagnose')}>3문항 진단 시작</a>
        <a class="btn ghost" href={url('/lenses')}>서비스 보기</a>
      </div>
    </div>
    <FocusField />
  </div>
</section>

<style>
  .hero { padding-block: 120px 88px; }
  @media (max-width: 760px) { .hero { padding-block: 92px 56px; } }
  .wrap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; align-items: center; }
  @media (max-width: 860px) { .wrap { grid-template-columns: 1fr; gap: 32px; } }
  .copy { display: grid; gap: 22px; justify-items: start; min-width: 0; }
  h1 { font-size: clamp(40px, 5.6vw, 78px); line-height: 1.08; letter-spacing: -.04em; font-weight: 700; }
  h1 em { font-style: normal; color: var(--core); }
  /* 단어가 차례로 초점이 맞으며 나타난다 (CSS만 사용: 스크립트가 없어도 제목은 보인다) */
  .w { display: inline-block; animation: focus-in .9s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--i) * 90ms + 80ms); }
  @keyframes focus-in { from { filter: blur(.22em); opacity: 0; transform: translateY(.12em); } to { filter: blur(0); opacity: 1; transform: none; } }
  /* 읽을 수 있을 만큼만 흐리다. 업무가 다 정리되면 완전히 선명해진다. */
  .soft { display: inline-block; filter: blur(calc(var(--messy, 0) * .032em)); opacity: calc(1 - var(--messy, 0) * .3); transition: filter .7s, opacity .7s; }
  .lede { font-size: clamp(16px, 1.5vw, 19px); color: var(--ink-2); max-width: 30em; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
  .cta .btn { min-height: 48px; padding-inline: 22px; }
</style>
