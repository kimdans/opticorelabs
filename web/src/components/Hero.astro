---
import { url } from '../lib/paths';
import Compare from './Compare.astro';
---
<!-- 첫 화면: 큰 제목 → 한 문단 설명과 버튼 → 도입 전/후 비교 화면. -->
<section class="hero gut" aria-labelledby="hero-title">
  <div class="inner">
    <div class="head">
      <h1 id="hero-title"><span class="l" style="--i:0"><span>흐릿한 업무를</span></span><span class="l" style="--i:1"><span><em>선명한 시스템</em>으로</span></span></h1>
      <div class="sub">
        <p>엑셀, 메신저 결재, 담당자 머릿속에 흩어진 일을 하나의 시스템으로 정리합니다. 진단부터 구축, 운영까지 한 팀이 맡습니다.</p>
        <div class="cta">
          <a class="btn" href={url('/diagnose')}>3문항으로 진단하기</a>
          <a class="btn ghost" href={url('/lenses')}>서비스 보기</a>
        </div>
      </div>
    </div>
    <div class="visual"><Compare /></div>
  </div>
</section>

<style>
  .hero { padding-block: 148px 40px; }
  @media (max-width: 760px) { .hero { padding-block: 104px 24px; } }
  .head { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 32px 64px; align-items: end; margin-bottom: clamp(36px, 5vw, 72px); }
  @media (max-width: 900px) { .head { grid-template-columns: 1fr; } }
  h1 { font-size: clamp(42px, 6.2vw, 88px); font-weight: 700; line-height: 1.16; letter-spacing: -.045em; }
  h1 em { font-style: normal; color: var(--core); }
  /* 줄 단위로 아래에서 올라온다 (CSS만 사용: 스크립트가 없어도 제목은 보인다) */
  .l { display: block; overflow: hidden; padding-bottom: .08em; margin-bottom: -.08em; }
  .l > span { display: block; animation: rise .9s var(--ease) both; animation-delay: calc(var(--i) * 110ms + 60ms); }
  @keyframes rise { from { transform: translateY(105%); } to { transform: none; } }
  .sub { display: grid; gap: 24px; justify-items: start; padding-bottom: 10px; animation: fade .9s var(--ease) .32s both; }
  .sub p { font-size: clamp(16px, 1.45vw, 19px); color: var(--ink-2); max-width: 30em; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; }
  .visual { animation: fade 1s var(--ease) .45s both; }
  @keyframes fade { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
</style>
