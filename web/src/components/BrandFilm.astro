---
import { url } from '../lib/paths';

// 브랜드 필름: 데스크톱 16:9, 휴대폰 4:5. 원본과 렌더 스크립트는 brand/motion/.
// AV1(WebM)을 먼저 시도하고, 재생 못 하는 브라우저는 H.264(MP4)를 쓴다.
const film = {
  desktop: { webm: url('/film/desktop.webm'), mp4: url('/film/desktop.mp4'), poster: url('/film/desktop.jpg') },
  mobile: { webm: url('/film/mobile.webm'), mp4: url('/film/mobile.mp4'), poster: url('/film/mobile.jpg') },
};
---
<section class="section gut film" id="film" aria-labelledby="film-title">
  <div class="inner">
    <div class="sec-head" data-reveal>
      <p class="eyebrow"><span class="dist">10 m</span> · 브랜드 필름 · 15초</p>
      <h2 id="film-title">흩어진 업무가 하나의 코어로 모이기까지.</h2>
    </div>
    <figure class="frame" data-state="idle"
      data-desktop-webm={film.desktop.webm} data-desktop-mp4={film.desktop.mp4} data-desktop-poster={film.desktop.poster}
      data-mobile-webm={film.mobile.webm} data-mobile-mp4={film.mobile.mp4} data-mobile-poster={film.mobile.poster}>
      <video muted loop playsinline preload="none" poster={film.desktop.poster}
        aria-label="오티코어 브랜드 필름. 흩어진 업무에 초점이 맞고, 네 개의 서비스와 네 단계를 지나 하나의 코어로 모인 뒤 오티코어 로고로 끝납니다."></video>
      <div class="controls">
        <button type="button" class="ctl" data-act="toggle" aria-label="재생">
          <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
          <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor" /></svg>
        </button>
        <button type="button" class="ctl wide" data-act="sound" aria-pressed="false">소리 켜기</button>
      </div>
      <button type="button" class="bigplay" data-act="toggle" aria-label="브랜드 필름 재생">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>필름 재생 · 15초
      </button>
    </figure>
  </div>
</section>

<style>
  .frame { position: relative; margin: 0; border-radius: 16px; overflow: hidden; background: #000; aspect-ratio: 16 / 9; box-shadow: 0 0 0 1px var(--edge); }
  @media (max-width: 767px) { .frame { aspect-ratio: 4 / 5; max-width: 560px; margin-inline: auto; } }
  video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .controls { position: absolute; right: 16px; bottom: 16px; display: flex; gap: 8px; opacity: 0; transition: opacity .25s; }
  .frame:hover .controls, .frame:focus-within .controls, .frame[data-state="paused"] .controls { opacity: 1; }
  @media (hover: none) { .controls { opacity: 1; } }
  .ctl { display: grid; place-items: center; height: 40px; min-width: 40px; padding: 0 12px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, .25); background: rgba(11, 12, 14, .6); color: #fff; font: 500 13px var(--f-body); cursor: pointer; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .ctl svg { width: 18px; height: 18px; }
  .ctl[aria-pressed="true"] { background: var(--core); border-color: var(--core); color: var(--on-core); }
  .i-pause { display: none; }
  .frame[data-state="playing"] .i-play { display: none; }
  .frame[data-state="playing"] .i-pause { display: block; }
  /* 정지 화면(로고)을 가리지 않도록 아래쪽 가운데에 둔다 */
  .bigplay { position: absolute; left: 50%; bottom: 9%; transform: translateX(-50%); height: 48px; padding: 0 22px 0 16px; border-radius: 999px; border: 0; background: var(--core); color: var(--on-core); display: none; align-items: center; gap: 8px; font: 600 15px var(--f-body); white-space: nowrap; cursor: pointer; box-shadow: 0 0 40px color-mix(in srgb, var(--core) 50%, transparent); }
  .bigplay svg { width: 22px; height: 22px; }
  /* 자동재생을 하지 않는 상태(동작 줄이기·데이터 절약·브라우저 차단)에서만 큰 재생 버튼을 보인다 */
  .frame[data-state="blocked"] .bigplay { display: inline-flex; }
  .frame[data-state="blocked"] .controls { display: none; }
</style>

<script>
  // 재생 상태는 하나의 이름 붙은 상태로만 관리한다: idle(아직 안 불러옴) → playing ↔ paused, 자동재생을 안 하면 blocked.
  type FilmState = 'idle' | 'playing' | 'paused' | 'blocked';
  const MOBILE = '(max-width: 767px)';

  document.querySelectorAll<HTMLElement>('.film .frame').forEach(frame => {
    const video = frame.querySelector('video')!;
    const toggleBtns = frame.querySelectorAll<HTMLButtonElement>('[data-act="toggle"]');
    const soundBtn = frame.querySelector<HTMLButtonElement>('[data-act="sound"]')!;
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    const noAutoplay = matchMedia('(prefers-reduced-motion: reduce)').matches || !!conn?.saveData;
    let state: FilmState = 'idle', userPaused = false, loadedVariant = '', visible = false;

    const set = (s: FilmState) => {
      state = s; frame.dataset.state = s;
      toggleBtns.forEach(b => b.setAttribute('aria-label', s === 'playing' ? '일시정지' : '재생'));
    };
    const variant = () => (matchMedia(MOBILE).matches ? 'mobile' : 'desktop');
    function load() {
      const v = variant();
      if (v === loadedVariant) return;
      loadedVariant = v;
      const d = frame.dataset;
      video.poster = d[`${v}Poster`]!;
      // <source>를 순서대로 두면 브라우저가 형식을 못 읽거나 파일이 없을 때 다음 것으로 넘어간다.
      const src = (href: string, type: string) => Object.assign(document.createElement('source'), { src: href, type });
      video.replaceChildren(src(d[`${v}Webm`]!, 'video/webm; codecs="av01.0.09M.10, opus"'), src(d[`${v}Mp4`]!, 'video/mp4'));
      video.load();
    }
    async function play(byUser = false) {
      load();
      try { await video.play(); set('playing'); if (byUser) userPaused = false; }
      catch { set('blocked'); }
    }
    function pause(byUser = false) { video.pause(); if (state !== 'blocked') set('paused'); if (byUser) userPaused = true; }

    toggleBtns.forEach(b => b.addEventListener('click', () => (state === 'playing' ? pause(true) : play(true))));
    soundBtn.addEventListener('click', () => {
      video.muted = !video.muted;
      soundBtn.setAttribute('aria-pressed', String(!video.muted));
      soundBtn.textContent = video.muted ? '소리 켜기' : '소리 끄기';
      if (!video.muted && state !== 'playing') play(true);
    });
    matchMedia(MOBILE).addEventListener('change', () => {
      if (state === 'idle') { video.poster = frame.dataset[`${variant()}Poster`]!; return; }
      const t = video.currentTime, was = state === 'playing'; load(); video.currentTime = t; if (was) play();
    });

    video.poster = frame.dataset[`${variant()}Poster`]!;
    if (noAutoplay) { set('blocked'); return; }
    // 화면에 40% 이상 보일 때만 재생하고, 벗어나면 멈춘다. 사용자가 직접 멈췄으면 다시 틀지 않는다.
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !userPaused) play();
      else if (!visible && state === 'playing') pause();
    }, { threshold: 0.4 }).observe(frame);
  });
</script>
