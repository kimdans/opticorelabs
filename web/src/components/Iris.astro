---
import { company } from '../data/site';
---
<section class="stage" id="top" aria-labelledby="hero-title">
  <div class="scene">
    <div>
      <h1 id="hero-title">흐릿한 업무를<br><em>선명한 시스템</em>으로.</h1>
      <p>SI · ERP · AX · SaaS를 하나의 코어로</p>
    </div>
  </div>
  <canvas id="iris" aria-hidden="true"></canvas>
  <div class="caption gut">
    <div class="inner cap">
      <div class="l">
        <p class="eyebrow">{company.nameKo} · ∞</p>
        <h2>조리개를 열면, 회사의 핵심이 보입니다.</h2>
        <p>{company.summary}</p>
      </div>
      <div class="r" aria-hidden="true">
        <span>APERTURE · <b id="fnum">f/4</b></span>
        <div class="fstops" id="fstops">{['16', '11', '8', '5.6', '4', '2.8', '2', '1.4'].map(s => <span>{s}</span>)}</div>
      </div>
    </div>
  </div>
</section>

<style>
  .stage { position: relative; height: 100svh; min-height: 560px; overflow: hidden; }
  .scene { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; background: radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--core-deep) 55%, var(--body)) 0%, var(--body) 62%); }
  .scene h1 { font-weight: 700; font-size: clamp(34px, 6.4vw, 92px); line-height: 1.08; letter-spacing: -.04em; max-width: 9.5em; padding-inline: 16px; }
  .scene h1 em { font-style: normal; color: #FFFFFF; text-shadow: 0 0 40px color-mix(in srgb, var(--core) 70%, transparent); }
  .scene p { margin-top: 18px; color: color-mix(in srgb, var(--ink) 75%, transparent); }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .caption { position: absolute; left: 0; right: 0; bottom: max(24px, env(safe-area-inset-bottom, 0px)); pointer-events: none; }
  .cap { display: flex; justify-content: space-between; align-items: end; gap: 16px; flex-wrap: wrap; }
  .l { max-width: 30em; }
  .l h2 { font-size: clamp(20px, 2.6vw, 30px); letter-spacing: -.02em; margin-top: 8px; }
  .l p:last-child { margin-top: 8px; color: var(--ink-2); font-size: 14px; }
  @media (max-width: 600px) { .l p:last-child { display: none; } }
  .r { font-family: var(--f-mono); font-size: 12px; color: var(--ink-2); text-align: right; }
  .r b { color: var(--ink); font-weight: 500; }
  .fstops { display: flex; gap: 10px; margin-top: 6px; justify-content: flex-end; flex-wrap: wrap; }
  .fstops :global(span.on) { color: var(--core); }
</style>

<script>
  import { gsap, reduceMotion } from '../scripts/motion';

  const cv = document.getElementById('iris') as HTMLCanvasElement;
  const ctx = cv.getContext('2d')!;
  const css = (n: string) => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
  const C = { body: css('--body'), a: css('--blade-a'), b: css('--blade-b'), edge: css('--edge'), core: css('--core') };
  const N = 9, REST = 0.64, reduce = reduceMotion();
  const state = { open: reduce ? 1.1 : 0.04, hole: 0, rot: 0, px: 0 };
  let W = 0, H = 0, dpr = 1;

  function draw() {
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const cx = W / 2, cy = H / 2, R0 = Math.min(W, H) * 0.42, diag = Math.hypot(W, H) / 2 + 40;
    const R = R0 + (diag - R0) * state.hole;
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = C.body; ctx.fillRect(0, 0, W, H);
    ctx.save(); ctx.globalCompositeOperation = 'destination-out'; ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2); ctx.fill(); ctx.restore();
    if (state.hole < 0.98) {
      ctx.save(); ctx.globalAlpha = 1 - state.hole; ctx.strokeStyle = C.edge; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.arc(cx, cy, R + 14, 0, Math.PI * 2); ctx.stroke();
      for (let i = 0; i < 120; i++) {
        const a = (i / 120) * Math.PI * 2 + state.rot * 0.25, l = i % 10 === 0 ? 12 : 5;
        ctx.beginPath(); ctx.moveTo(cx + Math.cos(a) * (R + 22), cy + Math.sin(a) * (R + 22));
        ctx.lineTo(cx + Math.cos(a) * (R + 22 + l), cy + Math.sin(a) * (R + 22 + l)); ctx.stroke();
      }
      ctx.restore();
    }
    const r = Math.max(2, R0 * state.open);
    if (r >= R) return;
    const rot = state.rot + state.px * 0.25;
    const V = Array.from({ length: N + 2 }, (_, i) => { const a = rot + (i * Math.PI * 2) / N; return [cx + Math.cos(a) * r, cy + Math.sin(a) * r]; });
    const E = (i: number) => { const dx = V[i + 1][0] - V[i][0], dy = V[i + 1][1] - V[i][1], d = Math.hypot(dx, dy) || 1; return [dx / d, dy / d]; };
    const L = R * 3;
    ctx.save(); ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2); ctx.clip();
    for (let i = 0; i < N; i++) {
      const p1 = V[i + 1], p2 = V[i + 2], e1 = E(i), e2 = E(i + 1);
      ctx.beginPath(); ctx.moveTo(p1[0], p1[1]); ctx.lineTo(p1[0] + e1[0] * L, p1[1] + e1[1] * L);
      ctx.lineTo(p2[0] + e2[0] * L, p2[1] + e2[1] * L); ctx.lineTo(p2[0], p2[1]); ctx.closePath();
      const g = ctx.createLinearGradient(p1[0], p1[1], p1[0] + e1[0] * R, p1[1] + e1[1] * R);
      g.addColorStop(0, i % 2 ? C.b : C.a); g.addColorStop(1, C.body);
      ctx.fillStyle = g; ctx.fill();
      ctx.strokeStyle = C.edge; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(p1[0], p1[1]); ctx.lineTo(p1[0] + e1[0] * L, p1[1] + e1[1] * L); ctx.stroke();
    }
    ctx.restore();
  }
  function size() { dpr = Math.min(2, devicePixelRatio || 1); W = cv.clientWidth; H = cv.clientHeight; cv.width = W * dpr; cv.height = H * dpr; draw(); }

  const stops = ['16', '11', '8', '5.6', '4', '2.8', '2', '1.4'];
  const spans = Array.from(document.querySelectorAll('#fstops span'));
  const fnum = document.getElementById('fnum')!;
  function readout() {
    const i = Math.max(0, Math.min(7, Math.round(((state.open - 0.04) / (1.02 - 0.04)) * 7)));
    fnum.textContent = 'f/' + stops[i];
    spans.forEach((s, j) => s.classList.toggle('on', j === i));
  }
  const update = () => { draw(); readout(); };
  addEventListener('resize', size); size(); readout();

  if (!reduce) {
    gsap.to(state, { open: REST, rot: 0.6, duration: 2, delay: 0.3, ease: 'expo.out', onUpdate: update });
    if (matchMedia('(pointer: fine)').matches)
      addEventListener('pointermove', e => gsap.to(state, { px: e.clientX / innerWidth - 0.5, duration: 0.8, ease: 'power3.out', onUpdate: draw }));
    gsap.timeline({ scrollTrigger: { trigger: '.stage', start: 'top top', end: '+=160%', pin: true, scrub: 0.7, onUpdate: update } })
      .fromTo(state, { open: REST, rot: 0.6 }, { open: 1.02, rot: 1.9, ease: 'power2.inOut', duration: 0.7, immediateRender: false })
      .to(state, { hole: 1, ease: 'power2.in', duration: 0.3 })
      .to('.caption', { opacity: 0, y: 20, duration: 0.2 }, 0);
  }
</script>
