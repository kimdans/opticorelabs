---
// 제휴 안내 목록. 공개된 항목은 안내 페이지로 링크하고, 초안(draft) 항목은 '준비 중'으로만 보여 준다.
import { url } from '../lib/paths';
import { partners } from '../data/partners';
---
<ul class="plist" role="list">
  {partners.map(p => (
    <li class:list={['pcard', { draft: p.draft }]}>
      <p class="meta"><span class="chip">{p.category}</span>{p.draft && <span class="chip soon">준비 중</span>}</p>
      <h3>{p.draft ? p.title : <a href={url(`/partners/${p.slug}`)}>{p.title}</a>}</h3>
      <p class="sum">{p.draft ? '서비스 제공 업체의 확인을 받는 중인 안내 페이지입니다. 확인이 끝나면 이곳에서 열어 보실 수 있습니다.' : p.summary}</p>
      {!p.draft && <p class="go"><a class="btn ghost" href={url(`/partners/${p.slug}`)}>안내 보기</a></p>}
    </li>
  ))}
</ul>
<style>
  .plist { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 16px; }
  .pcard { background: var(--surface); border-radius: 20px; padding: 28px; display: grid; gap: 12px; align-content: start; }
  .pcard.draft { background: transparent; box-shadow: inset 0 0 0 1.5px var(--edge); }
  .meta { display: flex; gap: 6px; flex-wrap: wrap; }
  .pcard.draft .chip { background: var(--body-2); }
  .soon { color: var(--ink); }
  h3 { font-size: 21px; font-weight: 700; }
  h3 a { text-decoration: none; }
  .sum { color: var(--ink-2); font-size: 15px; }
  .go { margin-top: 4px; }
</style>
