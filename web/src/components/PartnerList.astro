---
// 제휴 안내 목록. 공개된 항목만 보여 준다. 초안(draft) 항목은 제목·요약도 내보내지 않는다.
// 공개된 항목이 없으면 정직한 빈 상태 문구와 이용 방식을 보여 준다.
import { url } from '../lib/paths';
import { publishedPartners } from '../data/partners';
import { emptyPartners } from '../data/site';
const list = publishedPartners();
---
{list.length ? (
  <ul class="plist" role="list">
    {list.map(p => (
      <li class="pcard">
        <p class="meta"><span class="chip">{p.category}</span></p>
        <h3><a href={url(`/partners/${p.slug}`)}>{p.title}</a></h3>
        <p class="sum">{p.summary}</p>
        <p class="go"><a class="btn ghost" href={url(`/partners/${p.slug}`)}>안내 보기</a></p>
      </li>
    ))}
  </ul>
) : (
  <div class="empty" data-partners-empty>
    <p class="et">{emptyPartners.title}</p>
    <p>{emptyPartners.body}</p>
    <p class="how">{emptyPartners.how}</p>
  </div>
)}
<style>
  .plist { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 16px; }
  .pcard { background: var(--surface); border-radius: 20px; padding: 28px; display: grid; gap: 12px; align-content: start; }
  .meta { display: flex; gap: 6px; flex-wrap: wrap; }
  h3 { font-size: 21px; font-weight: 700; }
  h3 a { text-decoration: none; }
  .sum { color: var(--ink-2); font-size: 15px; }
  .go { margin-top: 4px; }
  .empty { background: var(--surface); border-radius: 20px; padding: 28px; display: grid; gap: 8px; max-width: 52em; }
  .et { font-size: 19px; font-weight: 700; }
  .how { color: var(--ink-2); font-size: 15px; margin-top: 4px; }
</style>
