---
import { promises } from '../data/site';
---
<ul class="promises" data-reveal="children">
  {promises.map(p => (
    <li><h3>{p.title}</h3><p>{p.body}</p></li>
  ))}
</ul>

<style>
  .promises { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 900px) { .promises { grid-template-columns: 1fr; } }
  li { padding: 24px; border-top: 2px solid var(--core); background: var(--body-2); border-radius: 0 0 16px 16px; display: grid; gap: 10px; align-content: start; }
  h3 { font-size: 19px; line-height: 1.4; }
  p { color: var(--ink-2); font-size: 15px; }
</style>
