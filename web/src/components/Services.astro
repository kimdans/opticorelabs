---
import { url } from '../lib/paths';
import { lenses } from '../data/site';
// 증상 문장("이럴 때")이 곧 서비스 카드의 제목이다. 고객은 자기 상황으로 서비스를 고른다.
---
<ul class="cards" data-reveal="children">
  {lenses.map(l => (
    <li class="card">
      <a href={url(`/lenses/${l.slug}`)}>
        <p class="when">{l.when}</p>
        <div class="who"><span class="code">{l.code}</span><span class="name">{l.name}</span></div>
        <ul class="does">{l.does.map(d => <li>{d}</li>)}</ul>
        <span class="more">자세히 보기 →</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 1100px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .cards { grid-template-columns: 1fr; } }
  .card a { position: relative; isolation: isolate; overflow: hidden; height: 100%; display: grid; grid-template-rows: auto auto 1fr auto; gap: 16px; padding: 24px; border: 1px solid var(--edge); border-radius: 16px; background: var(--body-2); text-decoration: none; transition: border-color .25s, translate .35s cubic-bezier(.2, .8, .2, 1); }
  .card a:hover, .card a:focus-visible { border-color: var(--core); translate: 0 -4px; }
  /* 포인터를 따라다니는 조명: 카드 묶음 전체에 하나의 빛이 지나간다 (--mx, --my는 스크립트가 넣는다) */
  .card a::before { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; opacity: 0; transition: opacity .4s;
    background: radial-gradient(340px circle at var(--mx, 50%) var(--my, 0%), color-mix(in srgb, var(--core) 24%, transparent), transparent 70%); }
  .cards.lit .card a::before { opacity: 1; }
  .more { transition: translate .3s; }
  .card a:hover .more { translate: 4px 0; }
  .when { font-size: 19px; font-weight: 700; line-height: 1.4; letter-spacing: -.01em; }
  .who { display: flex; align-items: baseline; gap: 8px; padding-top: 14px; border-top: 1px solid var(--line); }
  .code { font: 500 12px var(--f-mono); color: var(--core); letter-spacing: .06em; }
  .name { font-weight: 500; }
  .does { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; color: var(--ink-2); font-size: 14px; align-content: start; }
  .does li { padding-left: 14px; position: relative; }
  .does li::before { content: ""; position: absolute; left: 0; top: .75em; width: 5px; height: 5px; border-radius: 50%; background: var(--core); }
  .more { font-size: 14px; color: var(--core); }
</style>

<script>
  // 포인터 위치를 각 카드 기준 좌표로 넘겨, 옆 카드까지 빛이 번지게 한다.
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) document.querySelectorAll<HTMLElement>('.cards').forEach(list => {
    const cards = Array.from(list.querySelectorAll<HTMLElement>('.card a'));
    list.addEventListener('pointermove', e => {
      list.classList.add('lit');
      cards.forEach(c => { const b = c.getBoundingClientRect(); c.style.setProperty('--mx', `${e.clientX - b.left}px`); c.style.setProperty('--my', `${e.clientY - b.top}px`); });
    });
    list.addEventListener('pointerleave', () => list.classList.remove('lit'));
  });
</script>
