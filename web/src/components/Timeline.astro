---
import { states } from '../data/site';
// 진행 4단계를 실제 기간 비율로 그린 일정표. 진한 부분은 최소 기간, 옅은 부분은 최대 기간까지의 여유다.
const span: Record<string, [number, number]> = { SCAN: [2, 3], FOCUS: [2, 4], BUILD: [6, 16], RUN: [4, 4] };
let at = 0;
const rows = states.map(s => { const [min, max] = span[s.code]; const r = { ...s, start: at, min, max }; at += max; return r; });
const total = at;                       // 27주 눈금
const ticks = [0, 4, 8, 12, 16, 20, 24];
---
<div class="tl" data-timeline style={`--total:${total}`}>
  <div class="axis" aria-hidden="true"><span></span><div class="scale">{ticks.map(t => <i style={`--at:${t}`}>{t === 0 ? '시작' : `${t}주`}</i>)}</div></div>
  <ol>
    {rows.map((r, i) => (
      <li class={r.code === 'RUN' ? 'run' : ''} style={`--start:${r.start};--min:${r.min};--max:${r.max};--i:${i}`}>
        <div class="label">
          <p class="name"><span>{i + 1}</span>{r.ko}<em>{r.duration}</em></p>
          <p class="exit">{r.exit}</p>
        </div>
        <div class="track" aria-hidden="true"><i class="bar"><b></b></i></div>
      </li>
    ))}
  </ol>
</div>

<style>
  .tl { --label: minmax(280px, 34%); display: grid; gap: 0; }
  .axis, li { display: grid; grid-template-columns: var(--label) minmax(0, 1fr); column-gap: 40px; }
  .scale { position: relative; height: 28px; font-size: 13px; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .scale i { position: absolute; left: calc(var(--at) / var(--total) * 100%); font-style: normal; white-space: nowrap; }
  ol { list-style: none; margin: 0; padding: 0; }
  li { padding-block: 28px; border-top: 1px solid var(--edge); align-items: center; }
  li:last-child { border-bottom: 1px solid var(--edge); }
  .label { display: grid; gap: 8px; }
  .name { display: flex; align-items: center; gap: 12px; font-size: clamp(22px, 2.2vw, 28px); font-weight: 700; letter-spacing: -.03em; }
  .name span { width: 28px; height: 28px; border-radius: 50%; background: var(--ink); color: var(--body); font-size: 14px; font-weight: 600; display: grid; place-items: center; letter-spacing: 0; }
  .name em { font-style: normal; font-size: 15px; font-weight: 600; color: var(--core); letter-spacing: -.01em; }
  .exit { color: var(--ink-2); font-size: 15px; max-width: 26em; }
  /* 눈금선이 깔린 일정 칸 */
  .track { position: relative; height: 44px; background: repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px calc(4 / var(--total) * 100%)); }
  .bar { position: absolute; top: 6px; bottom: 6px; left: calc(var(--start) / var(--total) * 100%); width: calc(var(--max) / var(--total) * 100%); border-radius: 999px; background: color-mix(in srgb, var(--core) 22%, var(--body)); overflow: hidden; transform-origin: left; }
  .bar b { position: absolute; inset: 0 auto 0 0; width: calc(var(--min) / var(--max) * 100%); border-radius: 999px; background: var(--core); }
  /* 운영은 끝이 없다: 오른쪽이 열린 막대 */
  .run .bar { background: var(--ink); border-radius: 999px 0 0 999px; display: grid; align-items: center; padding-left: 16px; color: var(--body); font-size: 13px; font-weight: 600; font-style: normal; white-space: nowrap; }
  .run .bar::after { content: "계속 운영 →"; }
  .run .bar b { display: none; }
  /* 화면에 들어오면 단계 순서대로 막대가 자란다 (.wait는 스크립트가 붙였다 뗀다) */
  .bar { transition: transform 1s var(--ease); transition-delay: calc(var(--i) * 220ms + 100ms); }
  .tl.wait .bar { transform: scaleX(0); }
  @media (max-width: 820px) {
    .axis { display: none; }
    li { grid-template-columns: 1fr; row-gap: 16px; padding-block: 24px; }
    .track { height: 32px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-timeline]').forEach(el => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    el.classList.add('wait');
    new IntersectionObserver(([e], io) => { if (e.isIntersecting) { el.classList.remove('wait'); io.disconnect(); } }, { threshold: 0.25 }).observe(el);
  });
</script>
