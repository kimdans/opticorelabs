---
import { lenses } from '../data/site';
const ticks = Array.from({ length: 144 }, (_, i) => {
  const a = (i / 144) * Math.PI * 2, l = i % 12 === 0 ? 18 : i % 6 === 0 ? 11 : 6, r1 = 232, r2 = r1 - l;
  return { x1: (Math.sin(a) * r1).toFixed(1), y1: (-Math.cos(a) * r1).toFixed(1), x2: (Math.sin(a) * r2).toFixed(1), y2: (-Math.cos(a) * r2).toFixed(1), major: i % 12 === 0 };
});
---
<section class="ringsec gut" id="lenses" aria-labelledby="lenses-title">
  <div class="inner">
    <div class="head">
      <p class="eyebrow"><span class="dist">2 m</span> · 서비스</p>
      <h2 id="lenses-title">렌즈 링을 돌려 서비스를 고르세요.</h2>
    </div>
    <div class="wrap">
      <div class="ring">
        <svg viewBox="-260 -260 520 520" aria-hidden="true">
          <circle r="250" fill="none" stroke="var(--edge)" />
          <circle r="196" fill="var(--body-2)" stroke="var(--edge)" />
          <circle r="120" fill="none" stroke="var(--line)" />
          <circle r="64" fill="var(--body)" stroke="var(--edge)" />
          <rect x="-22" y="-22" width="44" height="44" rx="6" fill="var(--core)" />
          <g class="rot">
            {ticks.map(t => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke="var(--ink-2)" stroke-width={t.major ? 1.5 : 1} />)}
            <g font-family="Bricolage Grotesque, sans-serif" font-weight="800" fill="var(--ink)" text-anchor="middle" font-size="40">
              {lenses.map((l, i) => <text y="-142" transform={`rotate(${i * 90})`}>{l.code}</text>)}
            </g>
          </g>
          <path d="M0 -258 l-10 -16 h20 z" fill="var(--core)" />
        </svg>
      </div>
      <div class="details">
        <div class="tabs" role="tablist" aria-label="서비스">
          {lenses.map((l, i) => <button role="tab" type="button" id={`tab-${l.slug}`} aria-controls={`panel-${l.slug}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-i={i}>{l.code}</button>)}
        </div>
        {lenses.map((l, i) => (
          <div class="panel" role="tabpanel" id={`panel-${l.slug}`} aria-labelledby={`tab-${l.slug}`} hidden={i !== 0}>
            <div class="code">{l.code}</div>
            <h3>{l.name}</h3>
            <p class="what">{l.what}</p>
            <p class="when"><b>이럴 때</b>{l.when}</p>
            <a class="btn ghost" href={`/lenses/${l.slug}`}>{l.name} 자세히</a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .ringsec { min-height: 100svh; display: grid; align-content: center; padding-block: 80px 32px; overflow: hidden; border-top: 1px solid var(--line); }
  .head { display: grid; gap: 12px; margin-bottom: 24px; }
  .head h2 { font-size: clamp(28px, 4vw, 48px); letter-spacing: -.03em; }
  .wrap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; align-items: center; }
  @media (max-width: 860px) { .wrap { grid-template-columns: 1fr; gap: 24px; justify-items: center; } }
  .ring { width: min(460px, 38vw, calc(100svh - 300px)); aspect-ratio: 1; }
  @media (max-width: 860px) { .ring { width: min(340px, 78vw, 42svh); } }
  .ring svg { width: 100%; height: 100%; overflow: visible; }
  .details { min-width: 0; display: grid; gap: 18px; max-width: 32em; justify-self: stretch; }
  .tabs { display: flex; gap: 6px; flex-wrap: wrap; }
  .tabs button { font: 500 13px var(--f-mono); color: var(--ink-2); background: transparent; border: 1px solid var(--edge); border-radius: 999px; padding: 6px 12px; cursor: pointer; }
  .tabs button[aria-selected="true"] { color: var(--on-core); background: var(--core); border-color: var(--core); }
  .panel { display: grid; gap: 14px; justify-items: start; }
  .code { font-family: var(--f-display); font-weight: 800; font-size: clamp(56px, 8vw, 112px); line-height: .85; letter-spacing: -.05em; font-variation-settings: "opsz" 96; color: var(--core); }
  .panel h3 { font-size: 24px; }
  .what { color: var(--ink-2); }
  .when { border-top: 1px solid var(--line); padding-top: 14px; font-size: 15px; justify-self: stretch; }
  .when b { display: block; font: 400 12px var(--f-mono); color: var(--ink-2); letter-spacing: .06em; margin-bottom: 4px; }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion } from '../scripts/motion';

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('#lenses [role="tab"]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('#lenses [role="tabpanel"]'));
  const rot = document.querySelector<SVGGElement>('#lenses .rot')!;
  const reduce = reduceMotion();
  const desktop = matchMedia('(min-width: 861px)').matches;
  let cur = 0, trigger: ScrollTrigger | null = null;

  function select(i: number, fromScroll = false) {
    if (i !== cur) {
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(j === i)); t.tabIndex = j === i ? 0 : -1; });
      const show = () => panels.forEach((p, j) => (p.hidden = j !== i));
      if (reduce) show();
      else gsap.timeline().to(panels[cur], { opacity: 0, y: -8, duration: 0.15, onComplete: show }).fromTo(panels[i], { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.35, ease: 'power3.out' });
      cur = i;
    }
    if (!fromScroll) {
      if (trigger) { const y = trigger.start + (trigger.end - trigger.start) * (i / 3); window.scrollTo({ top: y + 1, behavior: reduce ? 'auto' : 'smooth' }); }
      else rot.setAttribute('transform', `rotate(${-i * 90})`);
    }
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(i));
    t.addEventListener('keydown', e => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (d) { const n = (i + d + 4) % 4; tabs[n].focus(); select(n); }
    });
  });

  // 데스크톱: 스크롤이 링을 돌린다. 모바일·동작 줄이기: 탭으로만 고른다(핀 없음).
  if (!reduce && desktop) {
    trigger = ScrollTrigger.create({ trigger: '#lenses', start: 'top top', end: '+=200%', pin: true, scrub: 0.6,
      onUpdate: s => { rot.setAttribute('transform', `rotate(${-s.progress * 270})`); select(Math.min(3, Math.round(s.progress * 3)), true); } });
  }
</script>
