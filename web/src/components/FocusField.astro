---
// 첫 화면의 체험: 포인터가 "초점 렌즈"가 되어 흩어진 업무를 지나가면, 선명해지며 시스템 기능으로 정리된다.
// 회사가 하는 일(흐릿한 업무 → 선명한 시스템)을 방문자가 직접 해 보게 하는 것이 목적이다.
const TOK: [string, string][] = [
  ['견적서_최종_진짜최종.xlsx', '견적·수주'], ['카톡으로 받는 결재', '전자결재'],
  ['수기 재고 장부', '실시간 재고'], ['쇼핑몰 주문 복붙', '주문 연동'],
  ['월말 마감 4일', '마감 자동화'], ['담당자만 아는 매크로', '워크플로'],
  ['메일로 온 세금계산서', '매입 수집'], ['"이거 누가 처리했죠?"', '감사 로그'],
  ['전화로 받은 발주', '발주 관리'], ['거래처 중복 312건', '거래처 통합'],
];
// 정리된 자리(가운데 코어를 사이에 둔 두 줄). 스크립트가 꺼진 브라우저는 이 자리에 정리된 모습만 본다.
const slot = (i: number) => ({ x: i % 2 ? 76 : 24, y: 12 + (Math.floor(i / 2) + 0.5) * (76 / (TOK.length / 2)) });
---
<div class="field" data-state="messy" data-focus-field>
  <div class="bar">
    <span class="lab" data-lab>오늘의 업무</span>
    <span class="count"><b data-n>0</b> / <span data-total>{TOK.length}</span> 정리됨</span>
  </div>
  <div class="stage" data-stage>
    <svg class="wires" data-wires viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">{TOK.map((_, i) => <path d={`M50 50 L50 ${slot(i).y} L${slot(i).x} ${slot(i).y}`} />)}</svg>
    <span class="hub" aria-hidden="true"><i></i></span>
    {TOK.map(([messy, clean], i) => (
      <div class="tok" data-i={i} style={`--sx:${slot(i).x}%;--sy:${slot(i).y}%`} aria-hidden="true"><span class="m">{messy}</span><span class="c">{clean}</span></div>
    ))}
    <div class="lens" data-lens aria-hidden="true"><i></i></div>
  </div>
  <div class="foot">
    <p data-hint>흩어진 업무에 초점을 맞춰 보세요. 선명해지면 정리됩니다.</p>
    <button type="button" data-reset hidden>다시 흩뜨리기</button>
  </div>
  <noscript><style is:inline>
    [data-focus-field] .tok { left: var(--sx) !important; top: var(--sy) !important; opacity: 1 !important; }
    [data-focus-field] .tok .m, [data-focus-field] .lens { display: none !important; }
    [data-focus-field] .tok .c { display: block !important; }
    [data-focus-field] .wires { clip-path: none !important; }
    [data-focus-field] .hub { scale: 1 !important; opacity: 1 !important; }
    [data-focus-field] .count, [data-focus-field] .foot { display: none !important; }
  </style></noscript>
  <p class="sr-only">시연: 엑셀 파일, 메신저 결재, 수기 장부처럼 흩어진 업무 열 가지에 초점을 맞추면 견적·수주, 전자결재, 실시간 재고 같은 시스템 기능으로 정리되어 하나로 연결됩니다.</p>
</div>

<style>
  .field { display: grid; grid-template-rows: auto 1fr auto; border: 1px solid var(--edge); border-radius: 20px; background: var(--body-2); overflow: hidden; min-width: 0; transition: border-color .6s; }
  .field[data-state="sorted"] { border-color: color-mix(in srgb, var(--core) 60%, var(--edge)); }
  .bar, .foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 18px; font-size: 13px; color: var(--ink-2); }
  .bar { border-bottom: 1px solid var(--line); font-family: var(--f-mono); letter-spacing: .04em; }
  .count b { color: var(--core); font-weight: 500; font-variant-numeric: tabular-nums; }
  .foot { border-top: 1px solid var(--line); min-height: 73px; }
  .foot p { transition: color .3s; }
  .field[data-state="sorted"] .foot p { color: var(--ink); font-weight: 500; font-size: 15px; }
  .foot button { font: 500 13px var(--f-body); color: var(--ink); background: transparent; border: 1px solid var(--edge); border-radius: 999px; padding: 0 16px; min-height: 44px; cursor: pointer; white-space: nowrap; }
  .foot button:hover { border-color: var(--core); }
  .stage { position: relative; height: 440px; touch-action: pan-y; overflow: hidden;
           background: radial-gradient(60% 60% at 50% 50%, color-mix(in srgb, var(--core-deep) 14%, transparent), transparent 70%); }
  @media (max-width: 860px) { .stage { height: 380px; } }
  @media (hover: hover) and (pointer: fine) { .field:not([data-state="sorted"]) .stage { cursor: none; } }

  .tok { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%) rotate(var(--r, 0deg)); white-space: nowrap; transition: left .7s cubic-bezier(.2, .9, .2, 1), top .7s cubic-bezier(.2, .9, .2, 1), transform .7s cubic-bezier(.2, .9, .2, 1), opacity .5s; will-change: left, top; }
  /* 스크립트가 준비되면(.ready) 가운데에서 흩어지며 나타난다 */
  .field:not(.ready) .tok, .field:not(.ready) .lens { opacity: 0; }
  .m { display: block; font: 500 13px var(--f-mono); padding: 8px 12px; border: 1px dashed color-mix(in srgb, var(--ink) 35%, transparent); border-radius: 8px; background: var(--body);
       filter: blur(calc((1 - var(--f, 0)) * 1.9px)); opacity: calc(.5 + var(--f, 0) * .5); transition: border-color .2s; }
  .tok.lock .m { border-style: solid; border-color: var(--core); }
  .c { display: none; font: 700 14px var(--f-body); color: var(--on-core); background: var(--core); padding: 8px 14px; border-radius: 999px; }
  .tok.on { z-index: 2; }
  .tok.on .m { display: none; }
  .tok.on .c { display: block; animation: pop .45s cubic-bezier(.2, 1.4, .4, 1); }
  @keyframes pop { from { transform: scale(.6); filter: blur(4px); } to { transform: scale(1); filter: blur(0); } }

  /* 다 정리되면 기능들이 가운데 코어에 선으로 이어진다: 흩어진 업무 → 하나의 시스템 */
  .wires { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .wires { clip-path: circle(0% at 50% 50%); transition: clip-path 1s cubic-bezier(.6, 0, .2, 1); }
  .wires :global(path) { fill: none; stroke: var(--core); stroke-width: 1.5; vector-effect: non-scaling-stroke; opacity: .7; }
  .field[data-state="sorted"] .wires { clip-path: circle(75% at 50% 50%); transition-delay: .5s; }
  .hub { position: absolute; left: 50%; top: 50%; width: 44px; height: 44px; margin: -22px 0 0 -22px; border-radius: 50%; border: 5px solid var(--ink); background: var(--body-2); display: grid; place-items: center; scale: 0; opacity: 0; transition: scale .6s cubic-bezier(.2, 1.5, .4, 1), opacity .3s; z-index: 1; }
  .hub i { width: 12px; height: 12px; border-radius: 3px; background: var(--core); }
  .field[data-state="sorted"] .hub { scale: 1; opacity: 1; transition-delay: .35s; }

  /* 렌즈 = 로고(원 + 가운데 사각형) */
  .lens { position: absolute; left: 0; top: 0; width: 132px; height: 132px; margin: -66px 0 0 -66px; border-radius: 50%; border: 3px solid var(--ink); pointer-events: none; display: grid; place-items: center; z-index: 3;
          background: radial-gradient(circle, color-mix(in srgb, var(--core) 10%, transparent), transparent 70%);
          box-shadow: 0 0 0 1px color-mix(in srgb, var(--core) 50%, transparent), 0 0 40px color-mix(in srgb, var(--core) 30%, transparent) inset, 0 0 60px color-mix(in srgb, var(--core) 18%, transparent); transition: opacity .4s, scale .5s cubic-bezier(.6, 0, .2, 1); }
  .lens i { width: 16px; height: 16px; border-radius: 4px; background: var(--core); }
  .field[data-state="sorted"] .lens { opacity: 0; scale: .34; transition: transform .5s cubic-bezier(.6, 0, .2, 1), scale .5s cubic-bezier(.6, 0, .2, 1), opacity .25s .35s; }
  @media (prefers-reduced-motion: reduce) { .lens { display: none; } }
</style>

<script>
  import { reduceMotion } from '../scripts/motion';

  // 상태는 세 가지뿐이다: messy(아직 하나도 안 정리됨) → sorting(일부 정리) → sorted(전부 정리)
  type FieldState = 'messy' | 'sorting' | 'sorted';
  const HINT: Record<FieldState, string> = {
    messy: '흩어진 업무에 초점을 맞춰 보세요. 선명해지면 정리됩니다.',
    sorting: '남은 업무에도 초점을 맞춰 보세요.',
    sorted: '이게 옵티코어가 하는 일입니다.',
  };
  const rng = (seed: number) => () => { seed = (seed + 0x6d2b79f5) | 0; let t = Math.imul(seed ^ (seed >>> 15), 1 | seed); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };

  document.querySelectorAll<HTMLElement>('[data-focus-field]').forEach(root => {
    const q = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const stage = q('[data-stage]'), lens = q('[data-lens]'), wires = q<SVGElement>('[data-wires]');
    const nEl = q('[data-n]'), totalEl = q('[data-total]'), hint = q('[data-hint]'), lab = q('[data-lab]'), reset = q<HTMLButtonElement>('[data-reset]');
    const narrow = matchMedia('(max-width: 860px)').matches;
    const all = Array.from(root.querySelectorAll<HTMLElement>('.tok'));
    const toks = all.slice(0, narrow ? 8 : 10); all.slice(toks.length).forEach(t => t.remove());
    const rows = toks.length / 2;
    totalEl.textContent = String(toks.length);

    // 정리된 자리: 가운데 코어를 사이에 둔 두 줄
    const slot = (i: number) => ({ x: i % 2 ? 76 : 24, y: 12 + (Math.floor(i / 2) + 0.5) * (76 / rows) });
    wires.innerHTML = toks.map((_, i) => { const s = slot(i); return `<path d="M50 50 L50 ${s.y} L${s.x} ${s.y}"/>`; }).join('');

    const edge = narrow ? 32 : 20;   // 좁은 화면에서는 긴 이름표가 잘리지 않게 가운데로 모은다
    let scatter: { x: number; y: number; r: number }[] = [];
    function shuffle(seed: number) {
      const r = rng(seed);
      // 정리된 자리와 다른 칸에서 시작하도록 순서를 섞고, 칸 안에서 흩뜨린다
      const order = toks.map((_, i) => i).sort(() => r() - 0.5);
      scatter = toks.map((_, i) => { const s = slot(order[i]); return { x: Math.min(100 - edge, Math.max(edge, s.x + (r() - 0.5) * 34)), y: Math.min(90, Math.max(10, s.y + (r() - 0.5) * 16)), r: (r() - 0.5) * 22 }; });
    }
    function place(i: number, on: boolean) {
      const t = toks[i], p = on ? slot(i) : scatter[i];
      t.classList.toggle('on', on); t.style.left = p.x + '%'; t.style.top = p.y + '%';
      t.style.setProperty('--r', (on ? 0 : scatter[i].r) + 'deg');
      t.classList.remove('lock'); if (!on) t.style.removeProperty('--f');
    }
    let state: FieldState = 'messy', done = new Set<number>(), dwell: number[] = [];
    function set(s: FieldState) {
      state = s; root.dataset.state = s; nEl.textContent = String(done.size);
      hint.textContent = HINT[s]; lab.textContent = s === 'sorted' ? '하나의 시스템' : '오늘의 업무';
      reset.hidden = s !== 'sorted';
      // 첫 화면 제목의 "흐릿한 업무를"이 정리된 만큼 선명해진다
      document.documentElement.style.setProperty('--messy', (1 - done.size / toks.length).toFixed(2));
    }
    function start(seed: number) { shuffle(seed); done = new Set(); dwell = toks.map(() => 0); toks.forEach((_, i) => place(i, false)); set('messy'); }

    root.classList.add('ready');
    if (reduceMotion()) { shuffle(7); toks.forEach((_, i) => { done.add(i); place(i, true); }); set('sorted'); reset.hidden = true; return; }
    start(7);

    // 렌즈: 포인터를 부드럽게 따라간다. 입력이 없으면 남은 업무를 가까운 것부터 스스로 찾아간다 (휴대폰이나 보기만 하는 방문자용).
    // 업무가 렌즈 안에 HOLD(ms) 동안 머물면 초점이 맞은 것으로 보고 정리한다. 빠르게 훑기만 하면 선명해졌다가 다시 흐려진다.
    const REACH = narrow ? 48 : 66, GLOW = 190, HOLD = 320, IDLE = 2500, SPEED = narrow ? 100 : 170;
    let W = 0, H = 0, tx = 0, ty = 0, lx = 0, ly = 0, lastInput = -1e9, autoAt = Infinity, touched = false, visible = false, raf = 0, prev = 0;
    const measure = () => { W = stage.clientWidth; H = stage.clientHeight; };
    measure(); addEventListener('resize', measure);
    tx = lx = W * 0.5; ty = ly = H * 0.5;
    const onPointer = (e: PointerEvent) => { const b = stage.getBoundingClientRect(); tx = e.clientX - b.left; ty = e.clientY - b.top; lastInput = performance.now(); touched = true; };
    stage.addEventListener('pointermove', onPointer); stage.addEventListener('pointerdown', onPointer);
    const pos = (i: number) => ({ x: (scatter[i].x / 100) * W, y: (scatter[i].y / 100) * H });

    function frame(now: number) {
      raf = 0;
      const dt = Math.min(50, now - (prev || now)); prev = now;
      const auto = now - lastInput > IDLE && now > autoAt;
      if (auto) {
        let best = -1, bd = Infinity;
        toks.forEach((_, i) => { if (done.has(i)) return; const p = pos(i), d = Math.hypot(p.x - lx, p.y - ly); if (d < bd) { bd = d; best = i; } });
        if (best >= 0 && bd > 1) { const p = pos(best), step = Math.min(bd, (SPEED * dt) / 1000); lx += ((p.x - lx) / bd) * step; ly += ((p.y - ly) / bd) * step; }
        tx = lx; ty = ly;
      } else { lx += (tx - lx) * 0.16; ly += (ty - ly) * 0.16; }
      lens.style.transform = `translate(${lx.toFixed(1)}px, ${ly.toFixed(1)}px)`;
      toks.forEach((t, i) => {
        if (done.has(i)) return;
        const p = pos(i), d = Math.hypot(p.x - lx, p.y - ly), inside = d < REACH;
        t.style.setProperty('--f', (inside ? 1 : Math.max(0, 1 - (d - REACH) / (GLOW - REACH)) * 0.7).toFixed(2));
        t.classList.toggle('lock', inside);
        dwell[i] = inside && (auto || touched) ? dwell[i] + dt : Math.max(0, dwell[i] - dt * 2);
        if (dwell[i] >= HOLD) { done.add(i); place(i, true); set(done.size === toks.length ? 'sorted' : 'sorting'); }
      });
      if (state === 'sorted') lens.style.transform = `translate(${(W / 2).toFixed(1)}px, ${(H / 2).toFixed(1)}px)`;   // 렌즈가 가운데 코어로 줄어든다
      if (visible && state !== 'sorted') raf = requestAnimationFrame(frame);
    }
    const kick = () => { if (!raf && visible && state !== 'sorted') { prev = 0; raf = requestAnimationFrame(frame); } };
    // 처음 화면에 들어오면 흩어진 모습을 잠깐 보여 준 뒤에 스스로 움직이기 시작한다
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible && autoAt === Infinity) autoAt = performance.now() + 1800; kick(); }, { threshold: 0.5 }).observe(stage);
    reset.addEventListener('click', () => { start(Math.floor(performance.now())); lx = tx = W / 2; ly = ty = H / 2; autoAt = performance.now() + 1200; lastInput = -1e9; kick(); });
  });
</script>
